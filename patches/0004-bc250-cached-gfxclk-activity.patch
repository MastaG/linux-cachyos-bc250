+/*
+ * Cached GetGfxclkFrequency. Avoids sending a mailbox message on every
+ * read; on success the value is served from cs_cache until the window
+ * expires. Mirrors the per-site hybrid fallback of the original code.
+ */
+static int cs_get_current_gfxclk(struct smu_context *smu, uint32_t *value,
+				 uint32_t fallback)
+{
+	int ret;
+
+	if (!cs_gfxclk_cache_ms) {
+		ret = smu_cmn_send_smc_msg(smu, SMU_MSG_GetGfxclkFrequency,
+					   value);
+		if (ret && !cyan_skillfish_use_hybrid_metrics()) {
+			*value = fallback;
+			ret = 0;
+		}
+		return ret;
+	}
+
+	mutex_lock(&cs_cache_lock);
+	if (cs_cache.gfxclk_valid &&
+	    !time_after(jiffies, cs_cache.gfxclk_refresh)) {
+		*value = cs_cache.gfxclk;
+		mutex_unlock(&cs_cache_lock);
+		return 0;
+	}
+	mutex_unlock(&cs_cache_lock);
+
+	ret = smu_cmn_send_smc_msg(smu, SMU_MSG_GetGfxclkFrequency, value);
+	if (ret && !cyan_skillfish_use_hybrid_metrics()) {
+		*value = fallback;
+		ret = 0;
+	}
+	if (!ret) {
+		mutex_lock(&cs_cache_lock);
+		cs_cache.gfxclk = *value;
+		cs_cache.gfxclk_refresh = jiffies +
+			msecs_to_jiffies(cs_gfxclk_cache_ms);
+		cs_cache.gfxclk_valid = true;
+		mutex_unlock(&cs_cache_lock);
+	}
+	return ret;
+}
+
+/*
+ * Cached GPU activity. Shares one GRBM sample between gpu_metrics and
+ * gpu_busy_percent instead of recomputing the ~1.55ms busy-wait per call.
+ */
+static uint16_t cs_get_gpu_activity(struct smu_context *smu)
+{
+	uint16_t activity;
+	unsigned long refresh;
+
+	if (!cs_activity_cache_ms)
+		return cyan_skillfish_get_gpu_activity(smu);
+
+	mutex_lock(&cs_cache_lock);
+	if (cs_cache.activity_valid &&
+	    !time_after(jiffies, cs_cache.activity_refresh)) {
+		activity = cs_cache.activity;
+		mutex_unlock(&cs_cache_lock);
+		return activity;
+	}
+	mutex_unlock(&cs_cache_lock);
+
+	activity = cyan_skillfish_get_gpu_activity(smu);
+	refresh = jiffies + msecs_to_jiffies(cs_activity_cache_ms);
+
+	mutex_lock(&cs_cache_lock);
+	cs_cache.activity = activity;
+	cs_cache.activity_refresh = refresh;
+	cs_cache.activity_valid = true;
+	mutex_unlock(&cs_cache_lock);
+
+	return activity;
+}
