+/*
+ * Short-lived caches for the two read-path queries the MastaG telemetry
+ * patch added: the GetGfxclkFrequency mailbox message and the GPU-activity
+ * GRBM busy-wait. Capping the refresh rate removes the extra mailbox
+ * message from each gpu_metrics read (it serializes on the SMU mailbox
+ * mutex with TransferTableSmu2Dram) and cuts the ~1.55ms MMIO busy-wait.
+ * Single BC-250 GPU per system, so file-scope state is sufficient.
+ * Set a window to 0 to disable caching (original behaviour).
+ */
+static DEFINE_MUTEX(cs_cache_lock);
+static uint cs_gfxclk_cache_ms = 200;
+module_param(cs_gfxclk_cache_ms, uint, 0644);
+MODULE_PARM_DESC(cs_gfxclk_cache_ms,
+		 "GetGfxclkFrequency mailbox cache window in ms (0 = off)");
+static uint cs_activity_cache_ms = 200;
+module_param(cs_activity_cache_ms, uint, 0644);
+MODULE_PARM_DESC(cs_activity_cache_ms,
+		 "GPU activity GRBM sample cache window in ms (0 = off)");
+
+static struct {
+	uint32_t gfxclk;
+	unsigned long gfxclk_refresh;
+	bool gfxclk_valid;
+	uint16_t activity;		/* centipercent, 0..10000 */
+	unsigned long activity_refresh;
+	bool activity_valid;
+} cs_cache;
+
