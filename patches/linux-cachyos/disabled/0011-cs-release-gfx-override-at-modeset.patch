+/*
+ * Push one GFX clock/voltage state to the SMU. Shared by the OD commit path
+ * and by the release/restore below so the two cannot drift apart. A vddc of
+ * CYAN_SKILLFISH_VDDC_MAGIC means "do not force a voltage", which is what
+ * PP_OD_RESTORE_DEFAULT_TABLE selects.
+ *
+ * Forcing goes through ForceGfxFreq (0x39), not RequestGfxclk (0xE), because
+ * only 0x39 can be undone: UnForceGfxFreq (0x3A) is its counterpart, while 0xE
+ * is a manual request with no "stop requesting" message at all. Measured on
+ * hardware: force 1800MHz via 0xE, send 0x3A, and the clock stays at 1800.
+ *
+ * This distinction is load-bearing, not cosmetic. A build identical to this one
+ * except that it released by requesting the default clock through 0xE still lost
+ * the display on a mode change, with the release firing correctly every time.
+ * The override has to actually come off.
+ */
+static int cs_od_send_gfx_state(struct smu_context *smu, uint32_t sclk,
+				uint32_t vddc)
+{
+	uint32_t vid;
+	int ret;
+
+	if (vddc == CYAN_SKILLFISH_VDDC_MAGIC) {
+		ret = smu_cmn_send_smc_msg(smu, SMU_MSG_UnForceGfxFreq, NULL);
+		if (ret) {
+			dev_err(smu->adev->dev, "Unforce sclk failed!\n");
+			return ret;
+		}
+
+		ret = smu_cmn_send_smc_msg(smu, SMU_MSG_UnforceGfxVid, NULL);
+		if (ret) {
+			dev_err(smu->adev->dev, "Unforce vddc failed!\n");
+			return ret;
+		}
+
+		return 0;
+	}
+
+	ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_ForceGfxFreq,
+					      sclk, NULL);
+	if (ret) {
+		dev_err(smu->adev->dev, "Force sclk failed!\n");
+		return ret;
+	}
+
+	/*
+	 * PMFW accepts SVI2 VID code, convert voltage to VID:
+	 * vid = (uint32_t)((1.55 - voltage) * 160.0 + 0.00001)
+	 */
+	vid = (1550 - vddc) * 160 / 1000;
+	ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_ForceGfxVid, vid, NULL);
+	if (ret) {
+		dev_err(smu->adev->dev, "Force vddc failed!\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * Release a held GFX clock/voltage override for the duration of a display
+ * modeset, and arm a restore.
+ *
+ * Why this exists: on a BC-250 driving HDMI 2.1 through an active DP->HDMI
+ * PCON, a *held* override makes the PCON's downstream link bring-up fail. The
+ * DP side trains fine and reports success, so DC never sees a problem -- the
+ * screen simply goes dark. Deferring OD commits around the modeset is not
+ * enough, because the damage is done by the override being held, not by a
+ * commit landing at a bad moment: measured on hardware, failures happened with
+ * no commit anywhere near them.
+ */
+void cs_od_force_suspend(void)
+{
+	struct smu_context *smu;
+	bool armed = false;
+
+	if (!cs_od_unforce_ms)
+		return;
+
+	mutex_lock(&cs_od_force_lock);
+	/*
+	 * Read inside the lock, not before it: cyan_skillfish_fini_smc_tables()
+	 * clears this under the same lock, so a teardown racing a modeset
+	 * cannot leave us sending mailbox messages to a device on its way out.
+	 */
+	smu = cs_od_smu;
+	if (!smu) {
+		mutex_unlock(&cs_od_force_lock);
+		return;
+	}
+
+	if (cs_od_force_suspended) {
+		/* Already released -- just hold it open a while longer. */
+		armed = true;
+	} else if (cyan_skillfish_user_settings.vddc != CYAN_SKILLFISH_VDDC_MAGIC) {
+		if (!cs_od_send_gfx_state(smu, cyan_skillfish_sclk_default,
+					  CYAN_SKILLFISH_VDDC_MAGIC)) {
+			WRITE_ONCE(cs_od_force_suspended, true);
+			armed = true;
+			if (cs_od_defer_debug)
+				dev_info(smu->adev->dev,
+					 "cs_od_defer: released forced GFX clock/voltage for modeset\n");
+		}
+	}
+	mutex_unlock(&cs_od_force_lock);
+
+	if (armed)
+		mod_delayed_work(system_wq, &cs_od_force_restore_work,
+				 msecs_to_jiffies(cs_od_unforce_ms));
+}
+
+static void cs_od_force_restore_work_fn(struct work_struct *work)
+{
+	struct smu_context *smu;
+
+	mutex_lock(&cs_od_force_lock);
+	smu = cs_od_smu;
+	if (cs_od_force_suspended && smu) {
+		/*
+		 * Whatever the user's settings are *now* -- an OD commit that
+		 * arrived while the release was open updated them and was
+		 * refused, so this is where it lands.
+		 */
+		cs_od_send_gfx_state(smu, cyan_skillfish_user_settings.sclk,
+				     cyan_skillfish_user_settings.vddc);
+		if (cs_od_defer_debug)
+			dev_info(smu->adev->dev,
+				 "cs_od_defer: restored forced GFX clock/voltage after modeset\n");
+	}
+	/*
+	 * Cleared even if the restore failed: leaving it set would wedge the
+	 * override off permanently, and unforced is the safe state to be
+	 * stuck in.
+	 */
+	WRITE_ONCE(cs_od_force_suspended, false);
+	mutex_unlock(&cs_od_force_lock);
+}
