+/*
+ * BC-250: opt-in quirk for DP to HDMI 2.1 adapters built on a Chrontel CH7218.
+ *
+ * Affected firmware clears DP_DOWNSTREAMPORT_PRESENT, or reports the detailed
+ * downstream port as DP, while the device identity and the EDID describe a DP
+ * to HDMI 2.1 PCON. DC then classifies the adapter DISPLAY_DONGLE_NONE, never
+ * runs FRL negotiation, and sends 4K90/4K120 as DP RGB, which the adapter
+ * cannot emit over TMDS. The sink stays black; 4K60 still works.
+ *
+ * Healthy CH7218 units report themselves correctly and need none of this, and
+ * nothing in the DPCD tells the two apart -- applying it unconditionally would
+ * override correct information from a working adapter. So it is opt-in:
+ * amdgpu.bc250_ch7218_quirk defaults to 0, every entry point below starts with
+ * the same gate, and with it unset this patch changes no behaviour at all.
+ *
+ * bc250_hdmi21 is required as well. The quirk exists to restore HDMI 2.1 PCON
+ * ceilings, which mean nothing if PCON support is off.
+ */
+#define BC250_CH7218_BRANCH_DEV_ID 0x2B02F0
+
+static bool bc250_ch7218_quirk_wanted(const struct dc_link *link)
+{
+	if (!link || !link->dc)
+		return false;
+
+	if (!link->dc->config.bc250_ch7218_quirk ||
+	    !link->dc->caps.dp_hdmi21_pcon_support)
+		return false;
+
+	/* branch_dev_name is int8_t[6], so this reads exactly the array. */
+	return link->dpcd_caps.branch_dev_id == BC250_CH7218_BRANCH_DEV_ID &&
+	       !memcmp(link->dpcd_caps.branch_dev_name, "CH7218", 6);
+}
+
+/*
+ * Declare the adapter to be what it physically is, and restore the ceilings
+ * its firmware failed to report. Safe to call from anywhere in converter
+ * detection: it returns immediately unless the quirk is enabled and the
+ * adapter identifies as a CH7218.
+ */
+static void bc250_ch7218_force_converter_identity(struct dc_link *link)
+{
+	if (!bc250_ch7218_quirk_wanted(link))
+		return;
+
+	link->dpcd_caps.is_branch_dev = true;
+	link->dpcd_caps.dongle_type = DISPLAY_DONGLE_DP_HDMI_CONVERTER;
+	link->dpcd_caps.dongle_caps.dongle_type = DISPLAY_DONGLE_DP_HDMI_CONVERTER;
+
+	link->dpcd_caps.dongle_caps.dp_hdmi_max_bpc = 12;
+	link->dpcd_caps.dongle_caps.dp_hdmi_frl_max_link_bw_in_kbps = 48000000;
+	link->dpcd_caps.dongle_caps.is_dp_hdmi_ycbcr422_pass_through = true;
+	link->dpcd_caps.dongle_caps.is_dp_hdmi_ycbcr420_pass_through = true;
+	link->dpcd_caps.dongle_caps.extendedCapValid = true;
+
+	DC_LOG_DC("BC-250: CH7218 quirk: forced HDMI 2.1 FRL PCON identity, 48 Gbps\n");
+}
+
+/*
+ * Some CH7218 firmware clears DP_DSC_SUPPORT while still returning a populated
+ * DSC decoder capability block. Only restore the bit when the block really is
+ * populated, so a genuinely DSC-less adapter is left alone even with the quirk
+ * enabled.
+ */
+static void bc250_ch7218_restore_dsc_support(struct dc_link *link)
+{
+	struct dpcd_dsc_capabilities *dsc_caps;
+
+	if (!bc250_ch7218_quirk_wanted(link))
+		return;
+
+	dsc_caps = &link->dpcd_caps.dsc_caps;
+	if (dsc_caps->dsc_basic_caps.fields.dsc_support.DSC_SUPPORT)
+		return;
+
+	if (!dsc_caps->dsc_basic_caps.raw[DP_DSC_REV - DP_DSC_SUPPORT] &&
+	    !dsc_caps->dsc_basic_caps.raw[DP_DSC_SLICE_CAP_1 - DP_DSC_SUPPORT] &&
+	    !dsc_caps->dsc_basic_caps.raw[DP_DSC_MAX_BITS_PER_PIXEL_LOW - DP_DSC_SUPPORT])
+		return;
+
+	dsc_caps->dsc_basic_caps.fields.dsc_support.DSC_SUPPORT = true;
+	DC_LOG_DC("BC-250: CH7218 quirk: restored cleared DSC_SUPPORT\n");
+}
+
 static void get_active_converter_info(
 	uint8_t data, struct dc_link *link)
 {
@@ -1169,9 +1253,11 @@
 	/* decode converter info*/
 	if (!ds_port.fields.PORT_PRESENT) {
 		link->dpcd_caps.dongle_type = DISPLAY_DONGLE_NONE;
+		link->dpcd_caps.is_branch_dev = false;
+		/* BC-250: no-op unless amdgpu.bc250_ch7218_quirk is set. */
+		bc250_ch7218_force_converter_identity(link);
 		set_dongle_type(link->ddc,
 				link->dpcd_caps.dongle_type);
-		link->dpcd_caps.is_branch_dev = false;
 		return;
 	}
 
@@ -1203,6 +1289,8 @@
 			/*Handle DP case as DONGLE_NONE*/
 			case DOWN_STREAM_DETAILED_DP:
 				link->dpcd_caps.dongle_type = DISPLAY_DONGLE_NONE;
+				/* BC-250: no-op unless amdgpu.bc250_ch7218_quirk is set. */
+				bc250_ch7218_force_converter_identity(link);
 				break;
 			case DOWN_STREAM_DETAILED_VGA:
 				link->dpcd_caps.dongle_type =
@@ -1329,6 +1417,14 @@
 		DC_LOG_DP2("\tdfp_cap_ext.max_video_h_active_width = %d", link->dpcd_caps.dongle_caps.dfp_cap_ext.max_video_h_active_width);
 		DC_LOG_DP2("\tdfp_cap_ext.max_video_v_active_height = %d", link->dpcd_caps.dongle_caps.dfp_cap_ext.max_video_v_active_height);
 	}
+
+	/*
+	 * BC-250: re-assert last. The DFP capability extension parsed above
+	 * overwrites the ceilings with what the firmware claims, which on an
+	 * affected CH7218 is exactly what is wrong. No-op unless
+	 * amdgpu.bc250_ch7218_quirk is set.
+	 */
+	bc250_ch7218_force_converter_identity(link);
 }
 
