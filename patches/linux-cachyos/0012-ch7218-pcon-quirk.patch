 /**
+ * DOC: bc250_ch7218_quirk (int)
+ * BC-250 (Cyan Skillfish, DCN 2.0.1) only. Opt-in workaround for DP to HDMI
+ * 2.1 adapters built on a Chrontel CH7218 whose firmware misreports its
+ * downstream port, so that the driver treats the adapter as a plain
+ * DisplayPort sink and sends 4K90/4K120 as DP RGB that the adapter cannot
+ * emit over TMDS -- a black screen, while 4K60 still works.
+ *
+ * Off by default, and deliberately so: nothing in the DPCD distinguishes an
+ * affected unit from a healthy one, so enabling this for everyone would
+ * override correct information reported by working adapters. Turn it on only
+ * if you have a CH7218 adapter that is black at 4K120 but fine at 4K60.
+ * Requires bc250_hdmi21=1 (the default). With this unset the driver behaves
+ * exactly as it would without the quirk.
+ * (0 = disabled (default), 1 = enabled)
+ */
+MODULE_PARM_DESC(bc250_ch7218_quirk, "BC-250: opt-in CH7218 DP-to-HDMI 2.1 adapter quirk (0 = disabled (default), 1 = enabled)");
+module_param_named(bc250_ch7218_quirk, amdgpu_bc250_ch7218_quirk, int, 0444);
