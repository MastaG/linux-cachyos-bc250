From: Local Kernel Test <kernel-test@localhost>
Date: Thu, 8 Oct 2026 22:10:42 +0200
Subject: [PATCH 1/4] amdgpu: decode BC-250 8-core SMU metrics

---
 .../pmfw_if/smu11_driver_if_cyan_skillfish.h  |  56 ++++
 .../amd/pm/swsmu/smu11/cyan_skillfish_ppt.c   | 297 +++++++++++++++---
 2 files changed, 307 insertions(+), 46 deletions(-)

diff --git a/drivers/gpu/drm/amd/pm/swsmu/inc/pmfw_if/smu11_driver_if_cyan_skillfish.h b/drivers/gpu/drm/amd/pm/swsmu/inc/pmfw_if/smu11_driver_if_cyan_skillfish.h
index 4884a4e1f..aa783559e 100644
--- a/drivers/gpu/drm/amd/pm/swsmu/inc/pmfw_if/smu11_driver_if_cyan_skillfish.h
+++ b/drivers/gpu/drm/amd/pm/swsmu/inc/pmfw_if/smu11_driver_if_cyan_skillfish.h
@@ -76,4 +76,60 @@ typedef struct SmuMetrics_t {
 	uint32_t Accnt;
 } SmuMetrics_t;
 
+/*
+ * Layout produced by a BC-250 whose SMU firmware carries the 8-core metrics
+ * patch (shipped in the newer community BIOS; see rw-r-r-0644/bc250-smu-unlock
+ * patches/metrics-8core.s, or apply it yourself with
+ * Forbidden-Darkness/AMD-BC-250-UEFI-v2.2-Firmware-Menu-Script). This is a
+ * clean 8-wide widening of the stock table: every per-core array covers all
+ * eight cores and GfxclkFrequency keeps a slot of its own. Boards that
+ * report 8 cores without this firmware patch are not supported -- their
+ * metrics table is still laid out as SmuMetricsTable_t above, and reading it
+ * as this layout will produce garbage.
+ *
+ * The offsets below are taken directly from the firmware patch's store
+ * instructions rather than inferred, e.g. CoreTemperature from
+ * "s16i a11, a10, 0x30", C0Residency from "s16i a8, a10, 0x48", Voltage from
+ * "s32i a10, a15, 0x64" and EdgeTemperature from "s16i a13, a2, 0x82". The
+ * patch also widens the export DMA to 0x11c bytes ("movi a12, 0x11c"), which
+ * matches sizeof(SmuMetrics_8core_t) exactly and is asserted below.
+ */
+typedef struct SmuMetricsTable_8core_t {
+	uint16_t CoreFrequency[8];		/* 0x00 */
+	uint32_t CorePower[8];			/* 0x10 */
+	uint16_t CoreTemperature[8];		/* 0x30 */
+	uint16_t L3Frequency[2];		/* 0x40 */
+	uint16_t L3Temperature[2];		/* 0x44 */
+	uint16_t C0Residency[8];		/* 0x48 */
+	uint16_t GfxclkFrequency;		/* 0x58 */
+	uint16_t GfxTemperature;		/* 0x5a */
+	uint16_t SocclkFrequency;		/* 0x5c */
+	uint16_t VclkFrequency;			/* 0x5e */
+	uint16_t DclkFrequency;			/* 0x60 */
+	uint16_t MemclkFrequency;		/* 0x62 */
+	uint32_t Voltage[2];			/* 0x64 */
+	uint32_t Current[2];			/* 0x6c */
+	uint32_t Power[2];			/* 0x74 */
+	uint32_t CurrentSocketPower;		/* 0x7c */
+	uint16_t SocTemperature;		/* 0x80 */
+	uint16_t EdgeTemperature;		/* 0x82 */
+	uint16_t ThrottlerStatus;		/* 0x84 */
+	uint16_t Spare;				/* 0x86 */
+} SmuMetricsTable_8core_t;
+
+static_assert(sizeof(SmuMetricsTable_8core_t) == 136,
+	      "8-core metrics table must remain 136 bytes");
+
+typedef struct SmuMetrics_8core_t {
+	SmuMetricsTable_8core_t Current;
+	SmuMetricsTable_8core_t Average;
+	uint32_t SampleStartTime;
+	uint32_t SampleStopTime;
+	uint32_t Accnt;
+} SmuMetrics_8core_t;
+
+/* Must equal the firmware's widened export DMA length of 0x11c. */
+static_assert(sizeof(SmuMetrics_8core_t) == 0x11c,
+	      "8-core metrics export must remain 284 bytes");
+
 #endif
diff --git a/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c b/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
index bb9620666..258479dd0 100644
--- a/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
+++ b/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
@@ -23,6 +23,10 @@
 
 #define SWSMU_CODE_LAYER_L2
 
+#include <linux/cpumask.h>
+#include <linux/limits.h>
+#include <linux/topology.h>
+
 #include "amdgpu.h"
 #include "amdgpu_smu.h"
 #include "smu_v11_0.h"
@@ -60,6 +64,158 @@ static struct gfx_user_settings {
 
 static uint32_t cyan_skillfish_sclk_default;
 
+/*
+ * Force the 8-core metrics layout. Normally the layout is selected
+ * automatically from the number of physical cores present.
+ */
+static bool cs_eight_core_map;
+module_param(cs_eight_core_map, bool, 0644);
+MODULE_PARM_DESC(cs_eight_core_map,
+		 "Force 8-core SMU metrics layout");
+
+/*
+ * An 8-core board is assumed to carry the 8-core metrics SMU firmware patch
+ * (see smu11_driver_if_cyan_skillfish.h's SmuMetricsTable_8core_t comment for
+ * how to get it). A board reporting 8 cores without that firmware patch is
+ * not supported and will decode garbage telemetry.
+ */
+enum cyan_skillfish_metrics_layout {
+	CS_METRICS_STOCK,		/* 6 cores, 116-byte tables */
+	CS_METRICS_8CORE,		/* patched SMU, 136-byte tables */
+};
+
+static uint16_t cyan_skillfish_core_count(void)
+{
+	unsigned int cpu;
+	uint16_t cores = 0;
+
+	for_each_present_cpu(cpu)
+		if (cpumask_first(topology_sibling_cpumask(cpu)) == cpu)
+			cores++;
+
+	return cores;
+}
+
+static enum cyan_skillfish_metrics_layout cyan_skillfish_metrics_layout(void)
+{
+	if (!cs_eight_core_map && cyan_skillfish_core_count() < 8)
+		return CS_METRICS_STOCK;
+
+	return CS_METRICS_8CORE;
+}
+
+/*
+ * Normalised view of one metrics table, so the sysfs, hwmon and gpu_metrics
+ * consumers do not each have to branch per layout. Fields the firmware does
+ * not provide are reported through the *_valid arrays rather than being
+ * filled with a value belonging to a different field.
+ */
+struct cyan_skillfish_metrics_view {
+	uint16_t CoreFrequency[8];
+	uint32_t CorePower[8];
+	uint16_t CoreTemperature[8];
+	uint16_t C0Residency[8];
+	uint16_t L3Frequency[2];
+	uint16_t L3Temperature[2];
+	uint16_t GfxclkFrequency;
+	uint16_t GfxTemperature;
+	uint16_t SocclkFrequency;
+	uint16_t VclkFrequency;
+	uint16_t DclkFrequency;
+	uint16_t MemclkFrequency;
+	uint32_t Voltage[2];
+	uint32_t Current[2];
+	uint32_t Power[2];
+	uint32_t CurrentSocketPower;
+	uint16_t SocTemperature;
+	uint16_t EdgeTemperature;
+	uint16_t ThrottlerStatus;
+	uint8_t ncores;
+	bool core_power_valid[8];
+	bool core_temp_valid[8];
+	bool c0_valid[8];
+};
+
+#define CS_VIEW_COPY_TAIL(v, t)						\
+	do {								\
+		(v)->GfxTemperature	= (t)->GfxTemperature;		\
+		(v)->SocclkFrequency	= (t)->SocclkFrequency;		\
+		(v)->VclkFrequency	= (t)->VclkFrequency;		\
+		(v)->DclkFrequency	= (t)->DclkFrequency;		\
+		(v)->MemclkFrequency	= (t)->MemclkFrequency;		\
+		(v)->Voltage[0]		= (t)->Voltage[0];		\
+		(v)->Voltage[1]		= (t)->Voltage[1];		\
+		(v)->Current[0]		= (t)->Current[0];		\
+		(v)->Current[1]		= (t)->Current[1];		\
+		(v)->Power[0]		= (t)->Power[0];		\
+		(v)->Power[1]		= (t)->Power[1];		\
+		(v)->CurrentSocketPower	= (t)->CurrentSocketPower;	\
+		(v)->SocTemperature	= (t)->SocTemperature;		\
+		(v)->EdgeTemperature	= (t)->EdgeTemperature;		\
+		(v)->ThrottlerStatus	= (t)->ThrottlerStatus;		\
+		(v)->L3Frequency[0]	= (t)->L3Frequency[0];		\
+		(v)->L3Frequency[1]	= (t)->L3Frequency[1];		\
+		(v)->L3Temperature[0]	= (t)->L3Temperature[0];	\
+		(v)->L3Temperature[1]	= (t)->L3Temperature[1];	\
+	} while (0)
+
+/*
+ * Decode the Current or Average table of the metrics buffer into the view.
+ * The Average table follows Current, so its offset depends on the layout's
+ * table stride, which is why the buffer is cast per layout rather than
+ * indexed generically.
+ */
+static void cyan_skillfish_decode_metrics(const void *buf,
+					  enum cyan_skillfish_metrics_layout layout,
+					  bool average,
+					  struct cyan_skillfish_metrics_view *view)
+{
+	int i;
+
+	memset(view, 0, sizeof(*view));
+
+	if (layout == CS_METRICS_8CORE) {
+		const SmuMetrics_8core_t *m = buf;
+		const SmuMetricsTable_8core_t *t = average ? &m->Average
+							  : &m->Current;
+
+		view->ncores = 8;
+		for (i = 0; i < 8; i++) {
+			view->CoreFrequency[i]	= t->CoreFrequency[i];
+			view->CorePower[i]	= t->CorePower[i];
+			view->CoreTemperature[i] = t->CoreTemperature[i];
+			view->C0Residency[i]	= t->C0Residency[i];
+			view->core_power_valid[i] = true;
+			view->core_temp_valid[i] = true;
+			view->c0_valid[i]	= true;
+		}
+		view->GfxclkFrequency = t->GfxclkFrequency;
+		CS_VIEW_COPY_TAIL(view, t);
+		return;
+	}
+
+	/*
+	 * Stock 116-byte table: the 6-core layout.
+	 */
+	{
+		const SmuMetrics_t *m = buf;
+		const SmuMetricsTable_t *t = average ? &m->Average : &m->Current;
+
+		view->ncores = 6;
+		for (i = 0; i < 6; i++) {
+			view->CoreFrequency[i]	= t->CoreFrequency[i];
+			view->CorePower[i]	= t->CorePower[i];
+			view->CoreTemperature[i] = t->CoreTemperature[i];
+			view->C0Residency[i]	= t->C0Residency[i];
+			view->core_power_valid[i] = true;
+			view->core_temp_valid[i] = true;
+			view->c0_valid[i]	= true;
+		}
+		view->GfxclkFrequency = t->GfxclkFrequency;
+		CS_VIEW_COPY_TAIL(view, t);
+	}
+}
+
 static const struct smu_feature_bits cyan_skillfish_dpm_features = {
 	.bits = {
 		SMU_FEATURE_BIT_INIT(FEATURE_FCLK_DPM_BIT),
@@ -93,11 +249,11 @@ static int cyan_skillfish_tables_init(struct smu_context *smu)
 	int ret;
 
 	SMU_TABLE_INIT(tables, SMU_TABLE_SMU_METRICS,
-				sizeof(SmuMetrics_t),
+				sizeof(SmuMetrics_8core_t),
 				PAGE_SIZE,
 				AMDGPU_GEM_DOMAIN_VRAM);
 
-	smu_table->metrics_table = kzalloc_obj(SmuMetrics_t);
+	smu_table->metrics_table = kzalloc_obj(SmuMetrics_8core_t);
 	if (!smu_table->metrics_table)
 		goto err0_out;
 
@@ -134,51 +290,54 @@ cyan_skillfish_get_smu_metrics_data(struct smu_context *smu,
 					uint32_t *value)
 {
 	struct smu_table_context *smu_table = &smu->smu_table;
-	SmuMetrics_t *metrics = (SmuMetrics_t *)smu_table->metrics_table;
+	struct cyan_skillfish_metrics_view view;
+	bool average = member == METRICS_AVERAGE_SOCKETPOWER;
 	int ret = 0;
 
 	ret = smu_cmn_get_metrics_table(smu, NULL, false);
 	if (ret)
 		return ret;
 
+	cyan_skillfish_decode_metrics(smu_table->metrics_table,
+				      cyan_skillfish_metrics_layout(),
+				      average, &view);
+
 	switch (member) {
 	case METRICS_CURR_GFXCLK:
-		*value = metrics->Current.GfxclkFrequency;
+		*value = view.GfxclkFrequency;
 		break;
 	case METRICS_CURR_SOCCLK:
-		*value = metrics->Current.SocclkFrequency;
+		*value = view.SocclkFrequency;
 		break;
 	case METRICS_CURR_VCLK:
-		*value = metrics->Current.VclkFrequency;
+		*value = view.VclkFrequency;
 		break;
 	case METRICS_CURR_DCLK:
-		*value = metrics->Current.DclkFrequency;
+		*value = view.DclkFrequency;
 		break;
 	case METRICS_CURR_UCLK:
-		*value = metrics->Current.MemclkFrequency;
+		*value = view.MemclkFrequency;
 		break;
 	case METRICS_CURR_SOCKETPOWER:
-		*value = metrics->Current.CurrentSocketPower;
-		break;
 	case METRICS_AVERAGE_SOCKETPOWER:
-		*value = metrics->Average.CurrentSocketPower;
+		*value = view.CurrentSocketPower;
 		break;
 	case METRICS_TEMPERATURE_EDGE:
-		*value = metrics->Current.GfxTemperature / 100 *
+		*value = view.GfxTemperature / 100 *
 				SMU_TEMPERATURE_UNITS_PER_CENTIGRADES;
 		break;
 	case METRICS_TEMPERATURE_HOTSPOT:
-		*value = metrics->Current.SocTemperature / 100 *
+		*value = view.SocTemperature / 100 *
 				SMU_TEMPERATURE_UNITS_PER_CENTIGRADES;
 		break;
 	case METRICS_VOLTAGE_VDDSOC:
-		*value = metrics->Current.Voltage[0];
+		*value = view.Voltage[0];
 		break;
 	case METRICS_VOLTAGE_VDDGFX:
-		*value = metrics->Current.Voltage[1];
+		*value = view.Voltage[1];
 		break;
 	case METRICS_THROTTLER_STATUS:
-		*value = metrics->Current.ThrottlerStatus;
+		*value = view.ThrottlerStatus;
 		break;
 	default:
 		*value = UINT_MAX;
@@ -203,7 +362,8 @@ static int cyan_skillfish_read_sensor(struct smu_context *smu,
 		ret = cyan_skillfish_get_smu_metrics_data(smu,
 						   METRICS_CURR_GFXCLK,
 						   (uint32_t *)data);
-		*(uint32_t *)data *= 100;
+		if (!ret)
+			*(uint32_t *)data *= 100;
 		*size = 4;
 		break;
 	case AMDGPU_PP_SENSOR_GFX_MCLK:
@@ -382,54 +542,99 @@ static bool cyan_skillfish_is_dpm_running(struct smu_context *smu)
 					  cyan_skillfish_dpm_features.bits);
 }
 
+/*
+ * gpu_metrics_v2_2 reserves 0xffff as the unsupported-value sentinel while
+ * its power fields are only 16-bit milliwatts. Preserve that sentinel and
+ * saturate larger firmware values at the highest representable valid value
+ * instead of silently wrapping modulo 65536.
+ */
+static uint16_t cyan_skillfish_gpu_metrics_power(uint32_t power)
+{
+	return min_t(uint32_t, power, U16_MAX - 1);
+}
+
 static ssize_t cyan_skillfish_get_gpu_metrics(struct smu_context *smu,
 						void **table)
 {
 	struct gpu_metrics_v2_2 *gpu_metrics =
 		(struct gpu_metrics_v2_2 *)smu_driver_table_ptr(
 			smu, SMU_DRIVER_TABLE_GPU_METRICS);
-	SmuMetrics_t metrics;
+	struct cyan_skillfish_metrics_view cur, avg;
+	const struct cyan_skillfish_metrics_view *pcore;
+	enum cyan_skillfish_metrics_layout layout;
+	/* Sized for the largest layout; see cyan_skillfish_tables_init(). */
+	SmuMetrics_8core_t metrics;
 	int i, ret = 0;
 
 	ret = smu_cmn_get_metrics_table(smu, &metrics, true);
 	if (ret)
 		return ret;
 
+	layout = cyan_skillfish_metrics_layout();
+	cyan_skillfish_decode_metrics(&metrics, layout, false, &cur);
+	cyan_skillfish_decode_metrics(&metrics, layout, true, &avg);
+
 	smu_cmn_init_soft_gpu_metrics(gpu_metrics, 2, 2);
+	gpu_metrics->temperature_gfx = cur.GfxTemperature;
+	gpu_metrics->temperature_soc = cur.SocTemperature;
+
+	/*
+	 * Power[0] is the VDDCR_VDD (CPU) rail and Power[1] is VDDCR_GFX.
+	 * The stock Cyan Skillfish code put Power[0] in average_soc_power and
+	 * left average_cpu_power at the unsupported sentinel. Export the CPU
+	 * rail through the field intended for it and leave average_soc_power
+	 * untouched because the firmware table has no separate SoC rail value.
+	 */
+	gpu_metrics->average_socket_power =
+		cyan_skillfish_gpu_metrics_power(cur.CurrentSocketPower);
+	gpu_metrics->average_cpu_power =
+		cyan_skillfish_gpu_metrics_power(cur.Power[0]);
+	gpu_metrics->average_gfx_power =
+		cyan_skillfish_gpu_metrics_power(cur.Power[1]);
+
+	gpu_metrics->average_gfxclk_frequency = avg.GfxclkFrequency;
+	gpu_metrics->average_socclk_frequency = avg.SocclkFrequency;
+	gpu_metrics->average_uclk_frequency = avg.MemclkFrequency;
+	gpu_metrics->average_fclk_frequency = avg.MemclkFrequency;
+	gpu_metrics->average_vclk_frequency = avg.VclkFrequency;
+	gpu_metrics->average_dclk_frequency = avg.DclkFrequency;
+
+	gpu_metrics->current_gfxclk = cur.GfxclkFrequency;
+	gpu_metrics->current_socclk = cur.SocclkFrequency;
+	gpu_metrics->current_uclk = cur.MemclkFrequency;
+	gpu_metrics->current_fclk = cur.MemclkFrequency;
+	gpu_metrics->current_vclk = cur.VclkFrequency;
+	gpu_metrics->current_dclk = cur.DclkFrequency;
 
-	gpu_metrics->temperature_gfx = metrics.Current.GfxTemperature;
-	gpu_metrics->temperature_soc = metrics.Current.SocTemperature;
-
-	gpu_metrics->average_socket_power = metrics.Current.CurrentSocketPower;
-	gpu_metrics->average_soc_power = metrics.Current.Power[0];
-	gpu_metrics->average_gfx_power = metrics.Current.Power[1];
-
-	gpu_metrics->average_gfxclk_frequency = metrics.Average.GfxclkFrequency;
-	gpu_metrics->average_socclk_frequency = metrics.Average.SocclkFrequency;
-	gpu_metrics->average_uclk_frequency = metrics.Average.MemclkFrequency;
-	gpu_metrics->average_fclk_frequency = metrics.Average.MemclkFrequency;
-	gpu_metrics->average_vclk_frequency = metrics.Average.VclkFrequency;
-	gpu_metrics->average_dclk_frequency = metrics.Average.DclkFrequency;
-
-	gpu_metrics->current_gfxclk = metrics.Current.GfxclkFrequency;
-	gpu_metrics->current_socclk = metrics.Current.SocclkFrequency;
-	gpu_metrics->current_uclk = metrics.Current.MemclkFrequency;
-	gpu_metrics->current_fclk = metrics.Current.MemclkFrequency;
-	gpu_metrics->current_vclk = metrics.Current.VclkFrequency;
-	gpu_metrics->current_dclk = metrics.Current.DclkFrequency;
-
-	for (i = 0; i < 6; i++) {
-		gpu_metrics->temperature_core[i] = metrics.Current.CoreTemperature[i];
-		gpu_metrics->average_core_power[i] = metrics.Average.CorePower[i];
-		gpu_metrics->current_coreclk[i] = metrics.Current.CoreFrequency[i];
+	/*
+	 * Upstream sources per-core power from the Average table, which is
+	 * correct on the stock 6-core firmware. Neither 8-core firmware
+	 * maintains that field: the pre-patch one left Average six wide, and
+	 * the patched one widens the layout without populating the per-core
+	 * power average, reporting tens of milliwatts per core with all eight
+	 * pinned at 3850 MHz. The Current table there reports ~4 W each,
+	 * summing to the 34 W the VDDCR_VDD rail itself reports, so use the
+	 * instantaneous values whenever the average is not maintained. Fields
+	 * with no firmware slot keep the 0xffff sentinel set by
+	 * smu_cmn_init_soft_gpu_metrics().
+	 */
+	pcore = layout == CS_METRICS_STOCK ? &avg : &cur;
+
+	for (i = 0; i < cur.ncores; i++) {
+		gpu_metrics->current_coreclk[i] = cur.CoreFrequency[i];
+		if (cur.core_temp_valid[i])
+			gpu_metrics->temperature_core[i] = cur.CoreTemperature[i];
+		if (pcore->core_power_valid[i])
+			gpu_metrics->average_core_power[i] =
+				cyan_skillfish_gpu_metrics_power(pcore->CorePower[i]);
 	}
 
 	for (i = 0; i < 2; i++) {
-		gpu_metrics->temperature_l3[i] = metrics.Current.L3Temperature[i];
-		gpu_metrics->current_l3clk[i] = metrics.Current.L3Frequency[i];
+		gpu_metrics->temperature_l3[i] = cur.L3Temperature[i];
+		gpu_metrics->current_l3clk[i] = cur.L3Frequency[i];
 	}
 
-	gpu_metrics->throttle_status = metrics.Current.ThrottlerStatus;
+	gpu_metrics->throttle_status = cur.ThrottlerStatus;
 	gpu_metrics->system_clock_counter = ktime_get_boottime_ns();
 
 	*table = (void *)gpu_metrics;
-- 
