From: MastaG <badouri.g@gmail.com>
Subject: [PATCH] drm/amdgpu: enable the VCN 2.0 video block on the BC-250

Cyan Skillfish reports UVD/VCN 2.0.3 in its IP discovery table, but
mainline skips the block, so there is no hardware video decode or encode.
Add vcn_v2_0 for the BC-250 (PCI device 0x13fe), behind amdgpu.bc250_vcn=1
(default off: a failed bring-up hangs the board at boot, seen on the test
board), with the bring-up changes
the ps5-linux project found for this silicon (ps5-linux-patches PR #38,
which does the same for the PS5, device 0x13fb):

- one VCN instance, rings without doorbells
- firmware amdgpu/ps5_vcn.bin instead of the IP-version name; it is not in
  linux-firmware and comes from the bc250-vcn-fw package. Without the file
  the VCN block is simply left out and the rest of amdgpu is unaffected.
- power gating is left off at start, the block is soft reset in a fixed
  order, and a firmware that never reports ready returns -ETIMEDOUT
- stop falls back to a reset when the block never goes idle

No other board is affected: every change is keyed on device 0x13fe.

---
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu.h b/drivers/gpu/drm/amd/amdgpu/amdgpu.h
index 831e71aec33f..60d94d02a109 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu.h
@@ -259,6 +259,7 @@ extern int amdgpu_sg_display;
 extern int amdgpu_bc250_hdmi21;
 extern int amdgpu_bc250_ch7218_quirk;
 extern int amdgpu_bc250_pcon_force_dsc;
+extern int amdgpu_bc250_vcn;
 extern int amdgpu_umsch_mm;
 extern int amdgpu_seamless;
 extern int amdgpu_umsch_mm_fwlog;
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
index 7ab2ad2c5ba9..e7309732fdb9 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
@@ -2909,6 +2909,10 @@ static int amdgpu_discovery_set_mm_ip_blocks(struct amdgpu_device *adev)
 				amdgpu_device_ip_block_add(adev, &jpeg_v2_0_ip_block);
 			break;
 		case IP_VERSION(2, 0, 3):
+			if (adev->pdev->device == 0x13fe && amdgpu_bc250_vcn) {
+				adev->vcn.num_vcn_inst = 1;
+				amdgpu_device_ip_block_add(adev, &vcn_v2_0_ip_block);
+			}
 			break;
 		case IP_VERSION(2, 5, 0):
 			amdgpu_device_ip_block_add(adev, &vcn_v2_5_ip_block);
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
index 999c01d35d65..5ece7d106ff3 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
@@ -239,6 +239,7 @@ int amdgpu_sg_display = -1; /* auto */
 int amdgpu_bc250_hdmi21 = 1;
 int amdgpu_bc250_ch7218_quirk;
 int amdgpu_bc250_pcon_force_dsc;
+int amdgpu_bc250_vcn;
 int amdgpu_user_partt_mode = AMDGPU_AUTO_COMPUTE_PARTITION_MODE;
 int amdgpu_umsch_mm;
 int amdgpu_seamless = -1; /* auto */
@@ -1020,6 +1021,15 @@ module_param_named(bc250_hdmi21, amdgpu_bc250_hdmi21, int, 0444);
 MODULE_PARM_DESC(bc250_ch7218_quirk, "BC-250: opt-in CH7218 DP-to-HDMI 2.1 adapter quirk (0 = disabled (default), 1 = enabled)");
 module_param_named(bc250_ch7218_quirk, amdgpu_bc250_ch7218_quirk, int, 0444);
 
+/**
+ * DOC: bc250_vcn (int)
+ * BC-250: bring up the VCN 2.0 video block. Needs amdgpu/ps5_vcn.bin
+ * (bc250-vcn-fw). Experimental: a failed bring-up can hang the board at boot,
+ * so this is off unless asked for (0 = disabled (default), 1 = enabled).
+ */
+MODULE_PARM_DESC(bc250_vcn, "BC-250: experimental VCN 2.0 video block (0 = disabled (default), 1 = enabled)");
+module_param_named(bc250_vcn, amdgpu_bc250_vcn, int, 0444);
+
 /**
  * DOC: bc250_pcon_force_dsc (int)
  * BC-250 (Cyan Skillfish, DCN 2.0.1) only. Experimental, opt-in. Some DP to
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vcn.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_vcn.c
index 17db7264269e..7e3284225b7a 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vcn.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vcn.c
@@ -75,6 +75,7 @@ MODULE_FIRMWARE(FIRMWARE_RENOIR);
 MODULE_FIRMWARE(FIRMWARE_GREEN_SARDINE);
 MODULE_FIRMWARE(FIRMWARE_ALDEBARAN);
 MODULE_FIRMWARE(FIRMWARE_NAVI10);
+MODULE_FIRMWARE("amdgpu/ps5_vcn.bin");
 MODULE_FIRMWARE(FIRMWARE_NAVI14);
 MODULE_FIRMWARE(FIRMWARE_NAVI12);
 MODULE_FIRMWARE(FIRMWARE_SIENNA_CICHLID);
@@ -107,6 +108,8 @@ int amdgpu_vcn_early_init(struct amdgpu_device *adev, int i)
 	adev->vcn.inst[i].adev = adev;
 	adev->vcn.inst[i].inst = i;
 	amdgpu_ucode_ip_version_decode(adev, UVD_HWIP, ucode_prefix, sizeof(ucode_prefix));
+	if (adev->pdev->device == 0x13fe)
+		strscpy(ucode_prefix, "ps5_vcn", sizeof(ucode_prefix));
 
 	if (i != 0 && adev->vcn.per_inst_fw) {
 		r = amdgpu_ucode_request(adev, &adev->vcn.inst[i].fw,
@@ -116,8 +119,10 @@ int amdgpu_vcn_early_init(struct amdgpu_device *adev, int i)
 			amdgpu_ucode_release(&adev->vcn.inst[i].fw);
 	} else {
 		if (!adev->vcn.inst[0].fw) {
+			/* Out of tree firmware: absent means no VCN, not an error. */
 			r = amdgpu_ucode_request(adev, &adev->vcn.inst[0].fw,
-						 AMDGPU_UCODE_REQUIRED,
+						 adev->pdev->device == 0x13fe ?
+						 AMDGPU_UCODE_OPTIONAL : AMDGPU_UCODE_REQUIRED,
 						 "amdgpu/%s.bin", ucode_prefix);
 			if (r)
 				amdgpu_ucode_release(&adev->vcn.inst[0].fw);
diff --git a/drivers/gpu/drm/amd/amdgpu/vcn_v2_0.c b/drivers/gpu/drm/amd/amdgpu/vcn_v2_0.c
index 0442bfcfd384..4dcb3a435f12 100644
--- a/drivers/gpu/drm/amd/amdgpu/vcn_v2_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/vcn_v2_0.c
@@ -90,6 +90,25 @@ static const struct amdgpu_hwip_reg_entry vcn_reg_list_2_0[] = {
 	SOC15_REG_ENTRY_STR(VCN, 0, mmUVD_DPG_PAUSE)
 };
 
+static bool vcn_v2_0_is_bc250(struct amdgpu_device *adev)
+{
+	return adev->pdev->device == 0x13fe;
+}
+
+static void vcn_v2_0_bc250_reset(struct amdgpu_device *adev)
+{
+	WREG32_SOC15(UVD, 0, mmUVD_SOFT_RESET, 0x3ffff);
+	udelay(20);
+	WREG32_SOC15(UVD, 0, mmUVD_SOFT_RESET2, 1);
+	udelay(10);
+	WREG32_SOC15(UVD, 0, mmUVD_SOFT_RESET2, 0);
+	WREG32_SOC15(UVD, 0, mmUVD_SOFT_RESET,
+		UVD_SOFT_RESET__VCPU_SOFT_RESET_MASK);
+	udelay(20);
+	WREG32_SOC15(UVD, 0, mmUVD_SCRATCH2, 0);
+	WREG32_SOC15(UVD, 0, mmUVD_STATUS, 0);
+}
+
 static void vcn_v2_0_set_dec_ring_funcs(struct amdgpu_device *adev);
 static void vcn_v2_0_set_enc_ring_funcs(struct amdgpu_device *adev);
 static void vcn_v2_0_set_irq_funcs(struct amdgpu_device *adev);
@@ -167,7 +186,7 @@ static int vcn_v2_0_sw_init(struct amdgpu_ip_block *ip_block)
 
 	ring = &adev->vcn.inst->ring_dec;
 
-	ring->use_doorbell = true;
+	ring->use_doorbell = !vcn_v2_0_is_bc250(adev);
 	ring->doorbell_index = adev->doorbell_index.vcn.vcn_ring0_1 << 1;
 	ring->vm_hub = AMDGPU_MMHUB0(0);
 
@@ -199,7 +218,7 @@ static int vcn_v2_0_sw_init(struct amdgpu_ip_block *ip_block)
 		enum amdgpu_ring_priority_level hw_prio = amdgpu_vcn_get_enc_ring_prio(i);
 
 		ring = &adev->vcn.inst->ring_enc[i];
-		ring->use_doorbell = true;
+		ring->use_doorbell = !vcn_v2_0_is_bc250(adev);
 		ring->vm_hub = AMDGPU_MMHUB0(0);
 		if (!amdgpu_sriov_vf(adev))
 			ring->doorbell_index = (adev->doorbell_index.vcn.vcn_ring0_1 << 1) + 2 + i;
@@ -291,6 +310,12 @@ static int vcn_v2_0_hw_init(struct amdgpu_ip_block *ip_block)
 	if (amdgpu_sriov_vf(adev))
 		vcn_v2_0_start_sriov(adev);
 
+	if (vcn_v2_0_is_bc250(adev)) {
+		r = vcn_v2_0_set_pg_state(adev->vcn.inst, AMD_PG_STATE_UNGATE);
+		if (r)
+			return r;
+	}
+
 	r = amdgpu_ring_test_helper(ring);
 	if (r)
 		return r;
@@ -1013,7 +1038,27 @@ static int vcn_v2_0_start(struct amdgpu_vcn_inst *vinst)
 	if (adev->pg_flags & AMD_PG_SUPPORT_VCN_DPG)
 		return vcn_v2_0_start_dpg_mode(vinst, adev->vcn.inst->indirect_sram);
 
-	vcn_v2_0_disable_static_power_gating(vinst);
+	if (vcn_v2_0_is_bc250(adev)) {
+		WREG32_SOC15(UVD, 0, mmUVD_POWER_STATUS,
+			RREG32_SOC15(UVD, 0, mmUVD_POWER_STATUS) & 2);
+		WREG32_P(SOC15_REG_OFFSET(UVD, 0, mmUVD_SOFT_RESET),
+			UVD_SOFT_RESET__VCPU_SOFT_RESET_MASK,
+			~UVD_SOFT_RESET__VCPU_SOFT_RESET_MASK);
+		vcn_v2_0_bc250_reset(adev);
+		WREG32_SOC15(UVD, 0, mmUVD_RBC_RB_CNTL,
+			RREG32_SOC15(UVD, 0, mmUVD_RBC_RB_CNTL) |
+			UVD_RBC_RB_CNTL__RB_NO_FETCH_MASK |
+			UVD_RBC_RB_CNTL__RB_RPTR_WR_EN_MASK);
+		WREG32_SOC15(UVD, 0, mmUVD_RBC_RB_RPTR, 0);
+		WREG32_SOC15(UVD, 0, mmUVD_RBC_RB_WPTR, 0);
+		WREG32_SOC15(UVD, 0, mmUVD_RB_RPTR, 0);
+		WREG32_SOC15(UVD, 0, mmUVD_RB_WPTR, 0);
+		WREG32_SOC15(UVD, 0, mmUVD_RB_RPTR2, 0);
+		WREG32_SOC15(UVD, 0, mmUVD_RB_WPTR2, 0);
+		WREG32_SOC15(UVD, 0, mmJPEG_SYS_INT_STATUS, 0);
+	} else {
+		vcn_v2_0_disable_static_power_gating(vinst);
+	}
 
 	/* set uvd status busy */
 	tmp = RREG32_SOC15(UVD, 0, mmUVD_STATUS) | UVD_STATUS__UVD_BUSY;
@@ -1096,6 +1141,13 @@ static int vcn_v2_0_start(struct amdgpu_vcn_inst *vinst)
 				break;
 			mdelay(10);
 		}
+		if (vcn_v2_0_is_bc250(adev) && !(status & 2)) {
+			WREG32_P(SOC15_REG_OFFSET(UVD, 0, mmUVD_SOFT_RESET),
+				UVD_SOFT_RESET__VCPU_SOFT_RESET_MASK,
+				~UVD_SOFT_RESET__VCPU_SOFT_RESET_MASK);
+			dev_err(adev->dev, "VCN firmware did not become ready\n");
+			return -ETIMEDOUT;
+		}
 		r = 0;
 		if (status & 2)
 			break;
@@ -1228,6 +1280,8 @@ static int vcn_v2_0_stop(struct amdgpu_vcn_inst *vinst)
 
 	/* wait for uvd idle */
 	r = SOC15_WAIT_ON_RREG(VCN, 0, mmUVD_STATUS, UVD_STATUS__IDLE, 0x7);
+	if (r && vcn_v2_0_is_bc250(adev))
+		goto bc250_reset;
 	if (r)
 		return r;
 
@@ -1236,6 +1290,8 @@ static int vcn_v2_0_stop(struct amdgpu_vcn_inst *vinst)
 		UVD_LMI_STATUS__WRITE_CLEAN_MASK |
 		UVD_LMI_STATUS__WRITE_CLEAN_RAW_MASK;
 	r = SOC15_WAIT_ON_RREG(VCN, 0, mmUVD_LMI_STATUS, tmp, tmp);
+	if (r && vcn_v2_0_is_bc250(adev))
+		goto bc250_reset;
 	if (r)
 		return r;
 
@@ -1272,6 +1328,15 @@ static int vcn_v2_0_stop(struct amdgpu_vcn_inst *vinst)
 	/* clear status */
 	WREG32_SOC15(VCN, 0, mmUVD_STATUS, 0);
 
+	goto clock_gating;
+
+bc250_reset:
+	dev_warn(adev->dev, "VCN did not become idle, resetting\n");
+	WREG32_P(SOC15_REG_OFFSET(UVD, 0, mmUVD_VCPU_CNTL), 0,
+		~UVD_VCPU_CNTL__CLK_EN_MASK);
+	vcn_v2_0_bc250_reset(adev);
+
+clock_gating:
 	vcn_v2_0_enable_clock_gating(vinst);
 	vcn_v2_0_enable_static_power_gating(vinst);
 
