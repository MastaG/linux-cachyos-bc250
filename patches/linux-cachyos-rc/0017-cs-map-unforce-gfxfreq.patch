From: MastaG <mastag@gmail.com>
Subject: [PATCH] drm/amd/pm: map UnForceGfxFreq and keep requesting the default on a Cyan Skillfish release

PP_OD_RESTORE_DEFAULT_TABLE + commit is the only "give it back" the driver
offers, and it was doing half a job: it requested the *default* clock, which
is still a manual RequestGfxclk, and released only the voltage.

PPSMC_MSG_UnForceGfxFreq (0x3A) is declared in smu_v11_8_ppsmc.h beside the
ForceGfxVid/UnforceGfxVid pair the driver maps, and was never added to
cyan_skillfish_message_map. Map it and send it on a release.

But measured on hardware, it is NOT the counterpart of RequestGfxclk: force
1800 MHz via RequestGfxclk (0xE), send UnForceGfxFreq, and the clock stays at
1800. 0x3A undoes ForceGfxFreq (0x39), a mechanism this driver never uses.
RequestGfxclk has no release of its own -- there is no "request nothing".

So a release sends UnForceGfxFreq *and* still requests the default clock and
unforces the voltage. Sending only UnForceGfxFreq would have been a
regression: it moves nothing, so "restore defaults" would have left the clock
wherever the last commit put it.

This does not by itself fix the PCON mode-switch failure -- the clock cannot
be handed back to firmware DPM at all through this interface, which is
consistent with "the governor never ran since boot" being the only condition
that reliably switches modes. It is a correctness fix for the release path
and a documented measurement of what these two messages actually do.

--- a/drivers/gpu/drm/amd/pm/swsmu/inc/smu_types.h
+++ b/drivers/gpu/drm/amd/pm/swsmu/inc/smu_types.h
@@ -246,6 +246,7 @@
 	__SMU_DUMMY_MAP(ForceGfxVid),             \
 	__SMU_DUMMY_MAP(Spare0),                  \
 	__SMU_DUMMY_MAP(UnforceGfxVid),           \
+	__SMU_DUMMY_MAP(UnForceGfxFreq),          \
 	__SMU_DUMMY_MAP(HeavySBR),			\
 	__SMU_DUMMY_MAP(SetBadHBMPagesRetiredFlagsPerChannel), \
 	__SMU_DUMMY_MAP(EnableGfxImu), \
--- a/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
+++ b/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
@@ -394,6 +394,7 @@
 	MSG_MAP(RequestGfxclk,                  PPSMC_MSG_RequestGfxclk,		0),
 	MSG_MAP(ForceGfxVid,                    PPSMC_MSG_ForceGfxVid,			0),
 	MSG_MAP(UnforceGfxVid,                  PPSMC_MSG_UnforceGfxVid,		0),
+	MSG_MAP(UnForceGfxFreq,                 PPSMC_MSG_UnForceGfxFreq,		0),
 };
 
 static struct cmn2asic_mapping cyan_skillfish_table_map[SMU_TABLE_COUNT] = {
@@ -999,31 +1000,63 @@
 	uint32_t vid;
 	int ret;
 
-	ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_RequestGfxclk,
-					      sclk, NULL);
-	if (ret) {
-		dev_err(smu->adev->dev, "Set sclk failed!\n");
-		return ret;
-	}
-
+	/*
+	 * A release sends UnForceGfxFreq *and* still requests the default
+	 * clock, because on this firmware those are two different mechanisms
+	 * and only the second one actually moves anything.
+	 *
+	 * Measured on hardware: force to 1800 MHz via RequestGfxclk, then send
+	 * UnForceGfxFreq -- the clock stays at 1800. UnForceGfxFreq (0x3A) is
+	 * the counterpart of ForceGfxFreq (0x39), which this driver never
+	 * uses; it does not undo RequestGfxclk (0xE), and RequestGfxclk has no
+	 * counterpart of its own. There is no "request nothing", so the
+	 * closest thing to a release is to request the firmware's own default
+	 * and stop forcing the voltage.
+	 *
+	 * UnForceGfxFreq is still sent first: it is harmless where nothing
+	 * used ForceGfxFreq, and it is the correct release for the half of
+	 * the interface that does.
+	 */
 	if (vddc == CYAN_SKILLFISH_VDDC_MAGIC) {
-		ret = smu_cmn_send_smc_msg(smu, SMU_MSG_UnforceGfxVid, NULL);
+		ret = smu_cmn_send_smc_msg(smu, SMU_MSG_UnForceGfxFreq, NULL);
 		if (ret) {
-			dev_err(smu->adev->dev, "Unforce vddc failed!\n");
+			dev_err(smu->adev->dev, "Unforce sclk failed!\n");
 			return ret;
 		}
-	} else {
-		/*
-		 * PMFW accepts SVI2 VID code, convert voltage to VID:
-		 * vid = (uint32_t)((1.55 - voltage) * 160.0 + 0.00001)
-		 */
-		vid = (1550 - vddc) * 160 / 1000;
-		ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_ForceGfxVid,
-						      vid, NULL);
+
+		ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_RequestGfxclk,
+						      sclk, NULL);
+		if (ret) {
+			dev_err(smu->adev->dev, "Set sclk failed!\n");
+			return ret;
+		}
+
+		ret = smu_cmn_send_smc_msg(smu, SMU_MSG_UnforceGfxVid, NULL);
 		if (ret) {
-			dev_err(smu->adev->dev, "Force vddc failed!\n");
+			dev_err(smu->adev->dev, "Unforce vddc failed!\n");
 			return ret;
 		}
+
+		return 0;
+	}
+
+	ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_RequestGfxclk,
+					      sclk, NULL);
+	if (ret) {
+		dev_err(smu->adev->dev, "Set sclk failed!\n");
+		return ret;
+	}
+
+	/*
+	 * PMFW accepts SVI2 VID code, convert voltage to VID:
+	 * vid = (uint32_t)((1.55 - voltage) * 160.0 + 0.00001)
+	 */
+	vid = (1550 - vddc) * 160 / 1000;
+	ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_ForceGfxVid,
+					      vid, NULL);
+	if (ret) {
+		dev_err(smu->adev->dev, "Force vddc failed!\n");
+		return ret;
 	}
 
 	return 0;
