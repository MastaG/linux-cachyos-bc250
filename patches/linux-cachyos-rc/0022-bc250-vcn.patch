 						 "amdgpu/%s.bin", ucode_prefix);
 			if (r)
 				amdgpu_ucode_release(&adev->vcn.inst[0].fw);
@@ -203,7 +208,7 @@ int amdgpu_vcn_sw_init(struct amdgpu_device *adev, int i)
 	}
 
 	bo_size = AMDGPU_VCN_STACK_SIZE + AMDGPU_VCN_CONTEXT_SIZE;
-	if (adev->firmware.load_type != AMDGPU_FW_LOAD_PSP)
+	if (!amdgpu_vcn_fw_via_psp(adev))
 		bo_size += AMDGPU_GPU_PAGE_ALIGN(le32_to_cpu(hdr->ucode_size_bytes) + 8);
 
 	if (amdgpu_ip_version(adev, UVD_HWIP, 0) >= IP_VERSION(5, 0, 0)) {
@@ -394,7 +399,7 @@ int amdgpu_vcn_resume(struct amdgpu_device *adev, int i)
 		unsigned int offset;
 
 		hdr = (const struct common_firmware_header *)adev->vcn.inst[i].fw->data;
-		if (adev->firmware.load_type != AMDGPU_FW_LOAD_PSP) {
+		if (!amdgpu_vcn_fw_via_psp(adev)) {
 			offset = le32_to_cpu(hdr->ucode_array_offset_bytes);
 			if (drm_dev_enter(adev_to_drm(adev), &idx)) {
 				memcpy_toio(adev->vcn.inst[i].cpu_addr,
@@ -1127,11 +1132,17 @@ enum amdgpu_ring_priority_level amdgpu_vcn_get_enc_ring_prio(int ring)
 	}
 }
 
+bool amdgpu_vcn_fw_via_psp(struct amdgpu_device *adev)
+{
+	return adev->firmware.load_type == AMDGPU_FW_LOAD_PSP &&
+	       adev->pdev->device != 0x13fe;
+}
