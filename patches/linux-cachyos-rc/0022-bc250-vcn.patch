@@ -2185,6 +2185,18 @@ static int amdgpu_device_ip_early_init(struct amdgpu_device *adev)
 	return 0;
 }
 
+/* BC-250 VCN bring-up: name the IP block whose hw_init is about to run, so the last
+ * message before a freeze shows which block it is. */
+static void amdgpu_bc250_trace_hw_init(struct amdgpu_device *adev, int i)
+{
+	if (amdgpu_bc250_vcn && adev->pdev->device == 0x13fe) {
+		dev_info(adev->dev, "bc250-vcn: hw_init of IP block <%s>\n",
+			 adev->ip_blocks[i].version->funcs->name);
+		/* let the (threaded) console send it before a possible freeze */
+		msleep(150);
+	}
+}
