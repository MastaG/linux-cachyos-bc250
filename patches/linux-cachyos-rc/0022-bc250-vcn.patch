+ */
+MODULE_PARM_DESC(bc250_vcn, "BC-250: experimental VCN 2.0 video block (0 = disabled (default), 1 = enabled)");
+module_param_named(bc250_vcn, amdgpu_bc250_vcn, int, 0444);
