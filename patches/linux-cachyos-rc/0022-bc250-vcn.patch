+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vcn.h
@@ -276,6 +276,14 @@ struct dpg_pause_state {
 	enum internal_dpg_state jpeg;
 };
 
+/*
+ * BC-250: the BIOS-booted PSP refuses the out of tree ps5_vcn.bin
+ * (LOAD_IP_FW answers 0xFFFF0008), so the VCN firmware is copied into the VCN
+ * buffer by the driver (the direct path) while everything else stays on the
+ * PSP.
+ */
+bool amdgpu_vcn_fw_via_psp(struct amdgpu_device *adev);
+
 struct amdgpu_vcn_reg{
 	unsigned	data0;
 	unsigned	data1;
diff --git a/drivers/gpu/drm/amd/amdgpu/vcn_v2_0.c b/drivers/gpu/drm/amd/amdgpu/vcn_v2_0.c
index 0442bfcfd384..ceb6dcca14cc 100644
--- a/drivers/gpu/drm/amd/amdgpu/vcn_v2_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/vcn_v2_0.c
@@ -90,6 +90,35 @@ static const struct amdgpu_hwip_reg_entry vcn_reg_list_2_0[] = {
 	SOC15_REG_ENTRY_STR(VCN, 0, mmUVD_DPG_PAUSE)
 };
 
+static bool vcn_v2_0_is_bc250(struct amdgpu_device *adev)
+{
+	return adev->pdev->device == 0x13fe;
+}
+
+/* Breadcrumbs for the bring-up: the last one printed shows where a hang is. */
+#define BC250_VCN_TRACE(adev, fmt, ...) \
+	do { \
+		if (vcn_v2_0_is_bc250(adev)) { \
+			dev_info((adev)->dev, "bc250-vcn: " fmt "\n", ##__VA_ARGS__); \
+			/* let the (threaded) console send it before a possible freeze */ \
+			msleep(150); \
+		} \
+	} while (0)
+
+static void vcn_v2_0_bc250_reset(struct amdgpu_device *adev)
+{
+	WREG32_SOC15(UVD, 0, mmUVD_SOFT_RESET, 0x3ffff);
+	udelay(20);
+	WREG32_SOC15(UVD, 0, mmUVD_SOFT_RESET2, 1);
+	udelay(10);
+	WREG32_SOC15(UVD, 0, mmUVD_SOFT_RESET2, 0);
+	WREG32_SOC15(UVD, 0, mmUVD_SOFT_RESET,
+		UVD_SOFT_RESET__VCPU_SOFT_RESET_MASK);
+	udelay(20);
+	WREG32_SOC15(UVD, 0, mmUVD_SCRATCH2, 0);
+	WREG32_SOC15(UVD, 0, mmUVD_STATUS, 0);
+}
+
 static void vcn_v2_0_set_dec_ring_funcs(struct amdgpu_device *adev);
 static void vcn_v2_0_set_enc_ring_funcs(struct amdgpu_device *adev);
 static void vcn_v2_0_set_irq_funcs(struct amdgpu_device *adev);
@@ -155,19 +184,22 @@ static int vcn_v2_0_sw_init(struct amdgpu_ip_block *ip_block)
 			return r;
 	}
 
+	BC250_VCN_TRACE(adev, "sw_init: irqs registered");
 	r = amdgpu_vcn_sw_init(adev, 0);
+	BC250_VCN_TRACE(adev, "sw_init: amdgpu_vcn_sw_init returned %d", r);
 	if (r)
 		return r;
 
 	amdgpu_vcn_setup_ucode(adev, 0);
 
 	r = amdgpu_vcn_resume(adev, 0);
+	BC250_VCN_TRACE(adev, "sw_init: amdgpu_vcn_resume returned %d", r);
 	if (r)
 		return r;
 
 	ring = &adev->vcn.inst->ring_dec;
 
-	ring->use_doorbell = true;
+	ring->use_doorbell = !vcn_v2_0_is_bc250(adev);
 	ring->doorbell_index = adev->doorbell_index.vcn.vcn_ring0_1 << 1;
 	ring->vm_hub = AMDGPU_MMHUB0(0);
 
@@ -199,7 +231,7 @@ static int vcn_v2_0_sw_init(struct amdgpu_ip_block *ip_block)
 		enum amdgpu_ring_priority_level hw_prio = amdgpu_vcn_get_enc_ring_prio(i);
 
 		ring = &adev->vcn.inst->ring_enc[i];
-		ring->use_doorbell = true;
+		ring->use_doorbell = !vcn_v2_0_is_bc250(adev);
 		ring->vm_hub = AMDGPU_MMHUB0(0);
 		if (!amdgpu_sriov_vf(adev))
 			ring->doorbell_index = (adev->doorbell_index.vcn.vcn_ring0_1 << 1) + 2 + i;
@@ -285,13 +317,25 @@ static int vcn_v2_0_hw_init(struct amdgpu_ip_block *ip_block)
 	struct amdgpu_ring *ring = &adev->vcn.inst->ring_dec;
 	int i, r;
 
+	BC250_VCN_TRACE(adev, "hw_init: enter");
 	adev->nbio.funcs->vcn_doorbell_range(adev, ring->use_doorbell,
 					     ring->doorbell_index, 0);
+	BC250_VCN_TRACE(adev, "hw_init: doorbell range set");
 
 	if (amdgpu_sriov_vf(adev))
 		vcn_v2_0_start_sriov(adev);
 
+	if (vcn_v2_0_is_bc250(adev)) {
+		BC250_VCN_TRACE(adev, "hw_init: ungating");
+		r = vcn_v2_0_set_pg_state(adev->vcn.inst, AMD_PG_STATE_UNGATE);
+		BC250_VCN_TRACE(adev, "hw_init: ungate returned %d", r);
+		if (r)
+			return r;
+	}
+
+	BC250_VCN_TRACE(adev, "hw_init: decode ring test");
 	r = amdgpu_ring_test_helper(ring);
+	BC250_VCN_TRACE(adev, "hw_init: decode ring test returned %d", r);
 	if (r)
 		return r;
 
@@ -388,7 +432,7 @@ static void vcn_v2_0_mc_resume(struct amdgpu_vcn_inst *vinst)
 		return;
 
 	/* cache window 0: fw */
-	if (adev->firmware.load_type == AMDGPU_FW_LOAD_PSP) {
+	if (amdgpu_vcn_fw_via_psp(adev)) {
 		WREG32_SOC15(UVD, 0, mmUVD_LMI_VCPU_CACHE_64BIT_BAR_LOW,
 			(adev->firmware.ucode[AMDGPU_UCODE_ID_VCN].tmr_mc_addr_lo));
 		WREG32_SOC15(UVD, 0, mmUVD_LMI_VCPU_CACHE_64BIT_BAR_HIGH,
@@ -443,7 +487,7 @@ static void vcn_v2_0_mc_resume_dpg_mode(struct amdgpu_vcn_inst *vinst,
 	uint32_t offset;
 
 	/* cache window 0: fw */
-	if (adev->firmware.load_type == AMDGPU_FW_LOAD_PSP) {
+	if (amdgpu_vcn_fw_via_psp(adev)) {
 		if (!indirect) {
 			WREG32_SOC15_DPG_MODE(0, SOC15_DPG_MODE_OFFSET(
 				UVD, 0, mmUVD_LMI_VCPU_CACHE_64BIT_BAR_LOW),
@@ -1007,20 +1051,48 @@ static int vcn_v2_0_start(struct amdgpu_vcn_inst *vinst)
 	uint32_t lmi_swap_cntl;
 	int i, j, r;
 
+	BC250_VCN_TRACE(adev, "start: enter (dpm %d)", adev->pm.dpm_enabled);
 	if (adev->pm.dpm_enabled)
 		amdgpu_dpm_enable_vcn(adev, true, 0);
+	BC250_VCN_TRACE(adev, "start: dpm done");
 
 	if (adev->pg_flags & AMD_PG_SUPPORT_VCN_DPG)
 		return vcn_v2_0_start_dpg_mode(vinst, adev->vcn.inst->indirect_sram);
 
-	vcn_v2_0_disable_static_power_gating(vinst);
+	if (vcn_v2_0_is_bc250(adev)) {
+		BC250_VCN_TRACE(adev, "start: first register read (UVD_POWER_STATUS)");
+		BC250_VCN_TRACE(adev, "start: UVD_POWER_STATUS = 0x%08x",
+				RREG32_SOC15(UVD, 0, mmUVD_POWER_STATUS));
+		WREG32_SOC15(UVD, 0, mmUVD_POWER_STATUS,
+			RREG32_SOC15(UVD, 0, mmUVD_POWER_STATUS) & 2);
+		WREG32_P(SOC15_REG_OFFSET(UVD, 0, mmUVD_SOFT_RESET),
+			UVD_SOFT_RESET__VCPU_SOFT_RESET_MASK,
+			~UVD_SOFT_RESET__VCPU_SOFT_RESET_MASK);
+		vcn_v2_0_bc250_reset(adev);
+		WREG32_SOC15(UVD, 0, mmUVD_RBC_RB_CNTL,
+			RREG32_SOC15(UVD, 0, mmUVD_RBC_RB_CNTL) |
+			UVD_RBC_RB_CNTL__RB_NO_FETCH_MASK |
+			UVD_RBC_RB_CNTL__RB_RPTR_WR_EN_MASK);
+		WREG32_SOC15(UVD, 0, mmUVD_RBC_RB_RPTR, 0);
+		WREG32_SOC15(UVD, 0, mmUVD_RBC_RB_WPTR, 0);
+		WREG32_SOC15(UVD, 0, mmUVD_RB_RPTR, 0);
+		WREG32_SOC15(UVD, 0, mmUVD_RB_WPTR, 0);
+		WREG32_SOC15(UVD, 0, mmUVD_RB_RPTR2, 0);
+		WREG32_SOC15(UVD, 0, mmUVD_RB_WPTR2, 0);
+		WREG32_SOC15(UVD, 0, mmJPEG_SYS_INT_STATUS, 0);
+		BC250_VCN_TRACE(adev, "start: reset sequence done");
