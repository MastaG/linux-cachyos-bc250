 	bool force_hdmi21_frl_enc_enable;
 	bool use_default_clock_table;
 	bool force_bios_enable_lttpr;
diff --git a/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_capability.c b/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_capability.c
index 19779a5..3bcec12 100644
--- a/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_capability.c
+++ b/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_capability.c
@@ -1269,6 +1269,61 @@ static void bc250_ch7218_restore_dsc_support(struct dc_link *link)
 	DC_LOG_DC("BC-250: CH7218: restored cleared DSC_SUPPORT\n");
 }
 
+/*
+ * BC-250: amdgpu.bc250_pcon_force_dsc, experimental and off by default.
+ *
+ * Some DP-to-HDMI 2.1 converters whose silicon has a DSC 1.2a decoder ship
+ * firmware that advertises neither DSC nor FEC: a Cable Matters 102101 on a
+ * Synaptics VMM7100 (fw 7.02.120) reads all zeros from DP_DSC_SUPPORT through
+ * DP_DSC_BITS_PER_PIXEL_INC and 0 at DP_FEC_CAPABILITY. The DP 1.4 link then
+ * cannot carry 4K120 RGB and the stream falls back to YCbCr 4:2:2.
+ *
+ * When asked to, advertise a decoder on the adapter's behalf. The capability
+ * block is the one a known-good Chrontel CH7218 PCON reports (DSC 1.2, 12 bpp
+ * max, RGB/4:4:4/4:2:2, 8/10/12 bpc, 2560 px slices), with DSC_SUPPORT set
+ * and passthrough clear, and FEC is marked capable because DP 1.4 requires
+ * FEC under DSC. Only a DP-to-HDMI converter whose block is entirely zero is
+ * touched; anything that advertises DSC itself is left as reported. If the
+ * firmware really cannot decode, modes that need DSC come up black or
+ * corrupted and the parameter must be dropped.
+ */
+static const uint8_t bc250_pcon_dsc_template[16] = {
+	0x01, 0x21, 0x00, 0x07, 0x3b, 0x04, 0x01, 0xc0,
+	0x00, 0x07, 0x0e, 0x71, 0x08, 0x01, 0x00, 0x00,
+};
+
+static void bc250_pcon_force_dsc(struct dc_link *link)
+{
+	struct dpcd_dsc_capabilities *dsc_caps;
+	unsigned int i;
+
+	if (!link || !link->dc)
+		return;
+
+	if (!link->dc->config.bc250_pcon_force_dsc ||
+	    !link->dc->caps.dp_hdmi21_pcon_support)
+		return;
+
+	if (link->dpcd_caps.dongle_type != DISPLAY_DONGLE_DP_HDMI_CONVERTER)
+		return;
+
+	dsc_caps = &link->dpcd_caps.dsc_caps;
+	for (i = 0; i < sizeof(dsc_caps->dsc_basic_caps.raw); i++)
+		if (dsc_caps->dsc_basic_caps.raw[i])
+			return;
+
+	/* both are the 16-byte DP_DSC_SUPPORT..DP_DSC_BITS_PER_PIXEL_INC block */
+	memcpy(dsc_caps->dsc_basic_caps.raw, bc250_pcon_dsc_template,
+	       sizeof(dsc_caps->dsc_basic_caps.raw));
+	link->dpcd_caps.fec_cap.bits.FEC_CAPABLE = 1;
+
+	DC_LOG_WARNING("BC-250: pcon_force_dsc: advertising a DSC 1.2a decoder and FEC on behalf of branch %06x '%.6s' fw %02x.%02x, which reported none\n",
+		       link->dpcd_caps.branch_dev_id,
+		       (const char *)link->dpcd_caps.branch_dev_name,
+		       (unsigned int)(uint8_t)link->dpcd_caps.branch_fw_revision[0],
+		       (unsigned int)(uint8_t)link->dpcd_caps.branch_fw_revision[1]);
+}
+
 static void get_active_converter_info(
 	uint8_t data, struct dc_link *link)
 {
@@ -2158,6 +2213,8 @@ static bool retrieve_link_cap(struct dc_link *link)
 		if (status == DC_OK) {
 			/* BC-250: only acts on a CH7218 that contradicts itself. */
 			bc250_ch7218_restore_dsc_support(link);
+			/* BC-250: no-op unless amdgpu.bc250_pcon_force_dsc is set. */
+			bc250_pcon_force_dsc(link);
 			is_fec_supported = link->dpcd_caps.fec_cap.bits.FEC_CAPABLE;
 			is_dsc_basic_supported = link->dpcd_caps.dsc_caps.dsc_basic_caps.fields.dsc_support.DSC_SUPPORT;
 			is_dsc_passthrough_supported = link->dpcd_caps.dsc_caps.dsc_basic_caps.fields.dsc_support.DSC_PASSTHROUGH_SUPPORT;
