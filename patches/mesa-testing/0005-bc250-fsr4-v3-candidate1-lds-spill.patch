-sdot_4x8_a_b = ('iadd', ('iadd', ('imul24_relaxed', ('extract_i8', a, 0), ('extract_i8', b, 0)),
-                                 ('imul24_relaxed', ('extract_i8', a, 1), ('extract_i8', b, 1))),
