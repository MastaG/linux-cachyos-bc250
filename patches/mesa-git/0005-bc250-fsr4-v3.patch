From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: David Moraza Sanchez <dmorazasanchezmendo@gmail.com>
Date: Thu, 20 Aug 2026 00:00:00 +0000
Subject: [PATCH 5/5] radv,nir: BC-250 FSR4 deferred SDot lowering (EXP-042B /
 V3)

Speed up FSR4's INT8 path on GFX1013. GFX1013 has no working packed signed
dot product, so sdot_4x8_iadd falls back to software. Two changes make that
fallback much cheaper:

1. A dense-reduction prepass that expands the largest FSR4 reduction kernels
   into signed 24-bit multiply chains, using one or two dependency chains
   depending on the shape of the shader.
2. A deferred lowering round: remaining packed SDots are held through one
   full NIR optimization pass before the real capability set is restored and
   they are lowered to software. Keeping the SDot intact lets upstream's own
   iadd(sdot(a, b, 0), c) -> sdot(a, b, c) fold absorb FSR4's accumulator
   wrapper, which is what shortens the live ranges that were spilling.

A 64-shader FSR4 capture found register pressure and occupancy, not static
instruction count, govern runtime here: the worst shader in the corpus drops
from 1314 VGPR spills at 4 waves/SIMD to 0 spills at 6 waves/SIMD, despite a
higher naive instruction-cost estimate. Tested with FSR 4.1.1 in Cyberpunk
2077 at 63 FPS, up from 58 FPS pre-V3.

This never advertises hardware dot-product support and never emits the broken
v_dot4_i32_i8; has_sdot_4x8 is raised only inside the deferred optimization
round and restored before code generation.

Based on EXP-042B from BC-250 FSR4 testing (David Moraza Sanchez,
dmorazasanchez/bc250-fsr4, `v3` branch,
https://github.com/dmorazasanchez/bc250-fsr4/tree/v3), with the following
changes made while rebasing onto this tree:

 - The GFX1013 compute-queue/identity changes and the RADV_GFX103 override
   that ship inside upstream's bc250-fsr4-v3.patch are dropped: they
   duplicate 0001 and 0004 byte-for-byte.
 - The MAD forms are emitted as plain iadd(imul24_relaxed(..), ..) instead of
   borrowing ir3's imad24_ir3. ACO already fuses that pair into
   v_mad_i32_i24 (aco_optimizer.cpp), so the generated ISA is unchanged,
   while RADV no longer produces an opcode whose generic nir_opt_algebraic
   rules are written around ir3's assumptions. This also removes the need for
   nir_op_imad24_ir3 and nir_op_imul24 cases in ACO instruction selection.
 - The explicit iadd(0, OpSDot) wrapper rules are dropped. Upstream already
   folds iadd(a, 0) -> a and iadd(sdot(a, b, 0), c) -> sdot(a, b, c), and
   both are ungated, so they still run during the deferred round while the
   BC-250 lowering rules are switched off. That is the mechanism the deferred
   round relies on.
 - The LDS spill-slot override in aco_spill.cpp is dropped. It forced 102 LDS
   spill slots, which on GFX1013 (64 KiB LDS, 2 SIMDs/CU, 64-lane workgroups)
   is 25.5 KiB per workgroup and admits only 1 wave/SIMD, whereas the
   occupancy formula it overrode yields 20 slots for the 6 waves/SIMD the
   change was trying to preserve. It also mutated spill_ctx after the SGPR
   budget that depends on it had already been computed.
 - The deferred round is gated on the shader actually containing a packed
   signed dot product, so ordinary GFX1013 compute shaders no longer pay for
   a second full NIR optimization round.
---
 src/amd/vulkan/radv_shader.c          |  149 +++++++++++++++++++++++++++++++++
 src/compiler/nir/nir_opt_algebraic.py |   49 ++++++++++-
 2 files changed, 192 insertions(+), 6 deletions(-)

diff --git a/src/amd/vulkan/radv_shader.c b/src/amd/vulkan/radv_shader.c
index 451ea7008e7..3f268099872 100644
--- a/src/amd/vulkan/radv_shader.c
+++ b/src/amd/vulkan/radv_shader.c
@@ -169,6 +169,125 @@ radv_can_dump_shader_stats(const struct radv_compiler_info *compiler_info, nir_s
    return compiler_info->debug.dump_shader_stats && !is_meta_shader(nir);
 }
 
+
+/* EXP-039A: GFX1013 dense signed-dot prepass.
+ *
+ * FSR4's large INT8 reductions benefit from lowering data x data SDot to
+ * signed i24 MUL/MAD before the ordinary no-hardware-dot algebraic fallback.
+ * Keep this conservative: only compute shaders with at least 2304 packed
+ * signed dot instructions are eligible. This leaves ED7 (2048), 0d64 (512)
+ * and the short 20-dot kernels on the B2 path.
+ */
+struct bc250_dot_density {
+   unsigned sdot;
+   unsigned iadd;
+   unsigned imul;
+   unsigned bcsel;
+};
+
+static bool
+bc250_count_dot_density(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   (void)b;
+   struct bc250_dot_density *density = data;
+
+   if (alu->op == nir_op_sdot_4x8_iadd)
+      density->sdot++;
+   else if (alu->op == nir_op_iadd)
+      density->iadd++;
+   else if (alu->op == nir_op_imul)
+      density->imul++;
+   else if (alu->op == nir_op_bcsel)
+      density->bcsel++;
+
+   return false;
+}
+
+static bool
+bc250_lower_dense_sdot4x8_one(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   const bool two_chain = data && *(const bool *)data;
+
+   if (alu->op != nir_op_sdot_4x8_iadd)
+      return false;
+
+   if (nir_src_is_const(alu->src[0].src) || nir_src_is_const(alu->src[1].src))
+      return false;
+
+   b->cursor = nir_before_instr(&alu->instr);
+
+   nir_def *a = nir_ssa_for_alu_src(b, alu, 0);
+   nir_def *bv = nir_ssa_for_alu_src(b, alu, 1);
+   nir_def *c = nir_ssa_for_alu_src(b, alu, 2);
+   nir_def *r;
+
+   /* Emit plain iadd(imul24_relaxed(..), ..) pairs. ACO's optimizer fuses each
+    * of those into v_mad_i32_i24 by itself, so there is no need to spell out a
+    * MAD form here.
+    */
+   if (two_chain) {
+      /* Two short dependency chains: this avoids the MAD3 spill cluster and
+       * can preserve 6-wave occupancy on the densest reduction family.
+       */
+      nir_def *r01 = nir_build_alu2(b, nir_op_imul24_relaxed,
+                                    nir_extract_i8_imm(b, a, 0),
+                                    nir_extract_i8_imm(b, bv, 0));
+      r01 = nir_iadd(b, nir_build_alu2(b, nir_op_imul24_relaxed,
+                                       nir_extract_i8_imm(b, a, 1),
+                                       nir_extract_i8_imm(b, bv, 1)), r01);
+
+      nir_def *r23 = nir_build_alu2(b, nir_op_imul24_relaxed,
+                                    nir_extract_i8_imm(b, a, 2),
+                                    nir_extract_i8_imm(b, bv, 2));
+      r23 = nir_iadd(b, nir_build_alu2(b, nir_op_imul24_relaxed,
+                                       nir_extract_i8_imm(b, a, 3),
+                                       nir_extract_i8_imm(b, bv, 3)), r23);
+      r = nir_iadd(b, r01, r23);
+   } else {
+      /* For the other dense reduction families a single chain measured best
+       * and does not introduce new spills.
+       */
+      r = nir_build_alu2(b, nir_op_imul24_relaxed,
+                         nir_extract_i8_imm(b, a, 0),
+                         nir_extract_i8_imm(b, bv, 0));
+      for (unsigned i = 1; i < 4; i++) {
+         r = nir_iadd(b, nir_build_alu2(b, nir_op_imul24_relaxed,
+                                        nir_extract_i8_imm(b, a, i),
+                                        nir_extract_i8_imm(b, bv, i)), r);
+      }
+   }
+
+   r = nir_iadd(b, r, c);
+   nir_def_replace(&alu->def, r);
+   return true;
+}
+
+static bool
+bc250_lower_dense_sdot4x8(nir_shader *nir, const struct bc250_dot_density *density)
+{
+   /* Occupancy-first gate derived from a 64-shader FSR4 A/B. The 1088 and 1152
+    * SDot families never lost resident waves. In the 2304 family, control-rich
+    * forms (>=16 bcsel) also preserved 6 waves, while the low-control variants
+    * fell from 6 to 4, so those stay on the ordinary lowering path.
+    *
+    * These are exact instruction counts taken from one capture, so they are
+    * expected to stop matching if the FSR4 shaders or the NIR passes ahead of
+    * this one change. That only costs the extra tuning, never correctness.
+    */
+   const bool safe_1088 = density->sdot == 1088;
+   /* Low-IMUL 1152 (e955 family) is left to the deferred-SDot round below,
+    * where the audit showed a much larger win. */
+   const bool safe_1152 = density->sdot == 1152 && density->imul >= 100;
+   const bool safe_2304 = density->sdot == 2304 && density->bcsel >= 16;
+
+   if (!(safe_1088 || safe_1152 || safe_2304))
+      return false;
+
+   const bool two_chain = safe_1152 || safe_2304;
+   return nir_shader_alu_pass(nir, bc250_lower_dense_sdot4x8_one,
+                              nir_metadata_control_flow, (void *)&two_chain);
+}
+
 void
 radv_optimize_nir(struct nir_shader *shader, bool optimize_conservatively)
 {
@@ -803,7 +922,35 @@ radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct
       NIR_PASS(_, nir, nir_opt_find_array_copies);
       NIR_PASS(_, nir, nir_lower_vars_to_ssa);
 
-      radv_optimize_nir(nir, false);
+      /* BC-250/GFX1013: only compute shaders that actually contain packed
+       * signed dot products need the deferred lowering below. Everything else
+       * must not pay for a second full optimization round.
+       */
+      struct bc250_dot_density bc250_density = {0};
+      if (compiler_info->debug.family == CHIP_GFX1013 &&
+          nir->info.stage == MESA_SHADER_COMPUTE)
+         nir_shader_alu_pass(nir, bc250_count_dot_density, nir_metadata_all, &bc250_density);
+
+      if (bc250_density.sdot) {
+         NIR_PASS(_, nir, bc250_lower_dense_sdot4x8, &bc250_density);
+
+         /* Preserve every remaining signed packed SDot through one full NIR
+          * optimization round, then restore the real GFX1013 capabilities
+          * before lowering. This keeps the accumulator visible so upstream's
+          * own iadd(sdot(a, b, 0), c) -> sdot(a, b, c) fold can fuse FSR4's
+          * wrapper, which is what shortens the live ranges that were spilling.
+          * Native packed-dot stays disabled; this never advertises hardware
+          * support and never emits the broken v_dot4_i32_i8. */
+         const nir_shader_compiler_options *saved_options = nir->options;
+         nir_shader_compiler_options deferred_options = *saved_options;
+         deferred_options.has_sdot_4x8 = true;
+         nir->options = &deferred_options;
+         radv_optimize_nir(nir, false);
+         nir->options = saved_options;
+         radv_optimize_nir(nir, false);
+      } else {
+         radv_optimize_nir(nir, false);
+      }
 
       NIR_PASS(_, nir, nir_opt_memcpy);
       NIR_PASS(_, nir, nir_opt_deref);
diff --git a/src/compiler/nir/nir_opt_algebraic.py b/src/compiler/nir/nir_opt_algebraic.py
index 1f128e04c1e..fd4ed0a47ab 100644
--- a/src/compiler/nir/nir_opt_algebraic.py
+++ b/src/compiler/nir/nir_opt_algebraic.py
@@ -444,10 +444,35 @@ for sz in (16, 32, 64):
 
 # Shorthand for the expansion of just the dot product part of the [iu]dp4a
 # instructions.
-sdot_4x8_a_b = ('iadd', ('iadd', ('imul24_relaxed', ('extract_i8', a, 0), ('extract_i8', b, 0)),
-                                 ('imul24_relaxed', ('extract_i8', a, 1), ('extract_i8', b, 1))),
-                        ('iadd', ('imul24_relaxed', ('extract_i8', a, 2), ('extract_i8', b, 2)),
-                                 ('imul24_relaxed', ('extract_i8', a, 3), ('extract_i8', b, 3))))
+sdot_4x8_a_b_balanced = ('iadd',
+                    ('iadd',
+                     ('imul24_relaxed', ('extract_i8', a, 0), ('extract_i8', b, 0)),
+                     ('imul24_relaxed', ('extract_i8', a, 1), ('extract_i8', b, 1))),
+                    ('iadd',
+                     ('imul24_relaxed', ('extract_i8', a, 2), ('extract_i8', b, 2)),
+                     ('imul24_relaxed', ('extract_i8', a, 3), ('extract_i8', b, 3))))
+
+# Sink a non-constant accumulator into the innermost position of the
+# right-leaning chain. ACO fuses each iadd(imul24_relaxed(..), ..) pair into
+# v_mad_i32_i24 on its own, so spelling this as a MAD chain here would only
+# duplicate work the backend already does.
+sdot_4x8_a_b_madacc = ('iadd',
+                    ('imul24_relaxed', ('extract_i8', a, 3), ('extract_i8', b, 3)),
+                    ('iadd',
+                     ('imul24_relaxed', ('extract_i8', a, 2), ('extract_i8', b, 2)),
+                     ('iadd',
+                      ('imul24_relaxed', ('extract_i8', a, 1), ('extract_i8', b, 1)),
+                      ('iadd',
+                       ('imul24_relaxed', ('extract_i8', a, 0), ('extract_i8', b, 0)),
+                       c))))
+
+sdot_4x8_a_b_reassoc = ('iadd',
+                    ('imul24_relaxed', ('extract_i8', a, 3), ('extract_i8', b, 3)),
+                    ('iadd',
+                     ('imul24_relaxed', ('extract_i8', a, 2), ('extract_i8', b, 2)),
+                     ('iadd',
+                      ('imul24_relaxed', ('extract_i8', a, 1), ('extract_i8', b, 1)),
+                      ('imul24_relaxed', ('extract_i8', a, 0), ('extract_i8', b, 0)))))
 udot_4x8_a_b = ('iadd', ('iadd', ('umul24_relaxed', ('extract_u8', a, 0), ('extract_u8', b, 0)),
                                  ('umul24_relaxed', ('extract_u8', a, 1), ('extract_u8', b, 1))),
                         ('iadd', ('umul24_relaxed', ('extract_u8', a, 2), ('extract_u8', b, 2)),
@@ -462,7 +487,21 @@ udot_2x16_a_b = ('iadd', ('umul24_relaxed', ('extract_u16', a, 0), ('extract_u16
                          ('umul24_relaxed', ('extract_u16', a, 1), ('extract_u16', b, 1)))
 
 optimizations.extend([
-   (('sdot_4x8_iadd', a, b, c), ('iadd', sdot_4x8_a_b, c), '!options->has_sdot_4x8'),
+   # BC-250/GFX1013: pick the expansion shape by operand and accumulator kind.
+   # A constant operand lets the products fold, so the right-leaning chain wins;
+   # data x data with a constant accumulator stays on the balanced MUL24 tree,
+   # which avoids the pathological spilling found in the FSR4 shader audit.
+   #
+   # FSR4's iadd(0, OpSDot) wrapper needs no rule of its own: upstream already
+   # folds iadd(a, 0) -> a and iadd(sdot(a, b, 0), c) -> sdot(a, b, c), and both
+   # of those are ungated, so they still run during the deferred round below
+   # while every rule here is switched off.
+   (('sdot_4x8_iadd', '#a', b, 'c(is_not_const)'), sdot_4x8_a_b_madacc, '!options->has_sdot_4x8'),
+   (('sdot_4x8_iadd', a, '#b', 'c(is_not_const)'), sdot_4x8_a_b_madacc, '!options->has_sdot_4x8'),
+   (('sdot_4x8_iadd', '#a', b, '#c'), ('iadd', sdot_4x8_a_b_reassoc, c), '!options->has_sdot_4x8'),
+   (('sdot_4x8_iadd', a, '#b', '#c'), ('iadd', sdot_4x8_a_b_reassoc, c), '!options->has_sdot_4x8'),
+   (('sdot_4x8_iadd', a, b, '#c'), ('iadd', sdot_4x8_a_b_balanced, c), '!options->has_sdot_4x8'),
+   (('sdot_4x8_iadd', a, b, c), ('iadd', sdot_4x8_a_b_reassoc, c), '!options->has_sdot_4x8'),
    (('udot_4x8_uadd', a, b, c), ('iadd', udot_4x8_a_b, c), '!options->has_udot_4x8'),
    (('sudot_4x8_iadd', a, b, c), ('iadd', sudot_4x8_a_b, c), '!options->has_sudot_4x8'),
    (('sdot_2x16_iadd', a, b, c), ('iadd', sdot_2x16_a_b, c), '!options->has_dot_2x16'),
