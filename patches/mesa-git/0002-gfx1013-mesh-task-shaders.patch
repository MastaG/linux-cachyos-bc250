diff --git a/src/amd/common/ac_gpu_info.c b/src/amd/common/ac_gpu_info.c
index 6e69702f30f..21a497082a7 100644
--- a/src/amd/common/ac_gpu_info.c
+++ b/src/amd/common/ac_gpu_info.c
@@ -1043,6 +1043,20 @@ void ac_fill_bug_info(struct radeon_info *info)
       }
    }
 
+   /* Hardware capabilities used by RADV's opt-in GFX1013 mesh/task path.
+    *
+    * Mesh shading is offered; task shading is not. GFX1013 firmware 144 hangs
+    * on DISPATCH_TASKMESH_INDIRECT_MULTI_ACE with a zero indirect count, and
+    * the driver-side workaround this path used to extend was removed upstream
+    * in 5d95a8f141d ("radv: remove the workaround for
+    * has_taskmesh_indirect0_bug"), which disables task/mesh outright on
+    * affected firmware instead. Rather than carry deleted upstream code, this
+    * keeps the mesh half -- the part that was actually working here -- and
+    * leaves task shading off, which is where it already stood in practice.
+    */
+   info->has_gfx1013_mesh_shading = info->family == CHIP_GFX1013;
+   info->has_gfx1013_task_shading = false;
+
    info->has_export_conflict_bug = info->gfx_level == GFX11;
 
    /* When LLVM is fixed to handle multiparts shaders, this value will depend
