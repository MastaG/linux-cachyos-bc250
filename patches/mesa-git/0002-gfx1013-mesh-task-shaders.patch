+++ b/src/amd/vulkan/radv_physical_device.c
@@ -64,15 +64,34 @@ radv_perf_query_supported(const struct radv_physical_device *pdev)
 }
 
 static bool
-radv_taskmesh_enabled(const struct radv_physical_device *pdev)
+radv_mesh_enabled(const struct radv_physical_device *pdev)
 {
    const struct radv_instance *instance = radv_physical_device_instance(pdev);
 
    if (RADV_DEBUG(instance, NO_MESH_SHADER))
       return false;
 
-   return pdev->use_ngg && !pdev->use_llvm && pdev->info.gfx_level >= GFX10_3 && radv_compute_queue_enabled(pdev) &&
-          !pdev->info.has_taskmesh_indirect0_bug;
+   /* For GFX1013, gfx_level reaches GFX10_3 only when RADV_GFX103=1 is
+    * explicitly requested. Keep the hardware capability bit as an additional
+    * guard while leaving native GFX10.3+ devices unchanged.
+    */
+   return pdev->use_ngg && !pdev->use_llvm && pdev->info.gfx_level >= GFX10_3 &&
+          (pdev->info.family != CHIP_GFX1013 || pdev->info.has_gfx1013_mesh_shading);
+}
+
+static bool
+radv_task_enabled(const struct radv_physical_device *pdev)
+{
+   if (!radv_mesh_enabled(pdev) || !radv_compute_queue_enabled(pdev))
+      return false;
+
+   /* has_gfx1013_task_shading is false, so GFX1013 gets mesh without task.
+    * Every other device keeps upstream's behaviour exactly.
+    */
+   if (pdev->info.family == CHIP_GFX1013)
+      return pdev->info.has_gfx1013_task_shading;
+
+   return !pdev->info.has_taskmesh_indirect0_bug;
 }
 
