From 8b89906e971c2603c24d8c2f494a7ffeefcbf177 Mon Sep 17 00:00:00 2001
From: DryhoppedIPA <DryhoppedIPA@users.noreply.github.com>
Date: Wed, 12 Aug 2026 17:24:30 +0000
Subject: [PATCH 4/9] radv: add opt-in GFX10.3 override for GFX1013

Allow RADV_GFX103=1 to promote GFX1013 to the GFX10.3 software path. The option defaults to false; without it the device remains GFX10.1 and the experimental mesh/task feature exposure remains disabled.
---
 src/amd/vulkan/radv_physical_device.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index a95230f5042..26480ea4f70 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -2684,6 +2684,10 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
    }
 
    memcpy(&pdev->info, &winsys_info.base, sizeof(pdev->info));
+
+   if (pdev->info.family == CHIP_GFX1013 && debug_get_bool_option("RADV_GFX103", false))
+      pdev->info.gfx_level = GFX10_3;
+
    memcpy(&pdev->syncobj_sync_type, &winsys_info.syncobj_sync_type, sizeof(pdev->syncobj_sync_type));
 
    for (uint32_t p = RADEON_CTX_PRIORITY_LOW; p <= RADEON_CTX_PRIORITY_REALTIME; p++) {
-- 
