# Inputs of the ROCm + PyTorch build for the BC-250 (rocm/build-rocm.sh).
# Changing anything here (or under rocm/patches/) is what a new build is for;
# nothing else, and no CachyOS Python or ROCm update, needs one.

# TheRock: AMD's ROCm build system. Its rocm-libraries submodule at this commit
# is 9ea8cfc5e431, which rocm/patches/rocm-libraries/ applies to.
THEROCK_REPO=https://github.com/ROCm/TheRock.git
THEROCK_COMMIT=9632d3289d637171e64304f97d5cb44659110115

# PyTorch: AMD's fork, release/2.13 (what TheRock's own stable builds use).
# torchvision and torchaudio follow from it (--require-related-commit):
# vision release/0.28 fc4106acc, audio release/2.11.0.2 289149bdf.
PYTORCH_REPO=https://github.com/ROCm/pytorch.git
PYTORCH_COMMIT=02aa33a60be69e8323ba80a35ca0eb90813a33bc
PYTORCH_VERSION=2.13.0

# TheRock's manylinux build image (has the Python the wheels are built for).
BUILD_IMAGE=ghcr.io/rocm/therock_build_manylinux_x86_64@sha256:f1f9dd9b20404c239f01a02ffec61d6c2e80abcafe7fdac854f06169828e53ce
PYTHON_TAG=cp312-cp312
