# Maintainer: MastaG
#
# Mirror of the AUR aic8800d80-dkms package (maintainer XNicON), built from our
# fork instead of upstream so that it also builds on Linux 7.3: upstream
# shenmintao/aic8800d80 does not compile against 7.3's cfg80211 API, and the fix
# (https://github.com/shenmintao/aic8800d80/pull/91) is being held there until
# radxa ships its own. The fork branch is upstream main plus that one commit,
# pinned by hash. Drop back to plain upstream the moment #91 (or radxa's
# equivalent) lands.
#
# pkgrel is kept above the AUR package's so a system that installed the AUR
# build upgrades to this one on a normal pacman -Syu.
pkgname=aic8800d80-dkms
pkgver=1.0.0
pkgrel=7
pkgdesc="AIC8800D80 USB WiFi/Bluetooth driver (AX900, Tenda and similar) as DKMS modules, with the Linux 7.3 cfg80211 fix carried until upstream takes it"
arch=('x86_64')
url="https://github.com/shenmintao/aic8800d80"
license=('GPL-2.0-only')
depends=('dkms')
_fork="https://github.com/MastaG/aic8800d80"
_commit=bbabacb3bce72f4b9e10ba71fe387366d3b9cff4
source=("aic8800d80::git+${_fork}.git#commit=${_commit}")
sha256sums=('SKIP')

package() {
    cd "$srcdir/aic8800d80"

    # udev rules: USB mode switch for the composite device
    install -Dm644 aic.rules "$pkgdir/usr/lib/udev/rules.d/aic.rules"

    # device firmware, as upstream lays it out
    install -dm755 "$pkgdir/usr/lib/firmware"
    cp -dr --no-preserve=ownership fw/aic8800D80 "$pkgdir/usr/lib/firmware/"

    # DKMS source tree; the name/version come from dkms.conf (PACKAGE_NAME=aic8800)
    install -dm755 "$pkgdir/usr/src/aic8800-$pkgver"
    cp -dr --no-preserve=ownership . "$pkgdir/usr/src/aic8800-$pkgver/"
    rm -rf "$pkgdir/usr/src/aic8800-$pkgver/.git"
}
