# Maintainer: MastaG
#
# Pure metapackage: no files of its own, just a dependency list. pacman only
# re-resolves an already-installed package's dependencies when a *newer
# version* of that package appears in the repo, so pkgrel must be bumped
# every time the depends= array below changes (adding or removing a BC-250
# extra) -- otherwise `pacman -Syu` will not pull the new package in for
# users who already have this one installed. A kernel/Mesa/extras version
# bump alone does not require bumping this package; those are unpinned here
# and update independently through their own versions as always.
pkgname=linux-cachyos-bc250-meta
pkgver=1
pkgrel=3
pkgdesc="Metapackage for the recommended BC-250 CachyOS software set (kernel + headers + BC-250 extras)"
arch=('any')
url="https://github.com/MastaG/linux-cachyos-bc250"
license=('GPL-2.0-only')
depends=(
    'linux-cachyos-bc250'
    'linux-cachyos-bc250-headers'
    'bc250-dual-audio'
    # All three FSR4 Proton packages. They are alternatives rather than
    # complements -- same pinned payload, different Proton underneath -- so this
    # is deliberately more than a minimal set: it costs roughly 4.5 GB and puts
    # three compatibility tools in Steam, and the point is that a BC-250 owner
    # gets whichever one a given game prefers without having to know the
    # difference in advance.
    #
    # native is the fastest, having no runtime container; slr is the same Proton
    # built for the Steam Linux Runtime, which is the only one of the three that
    # can run a game with EasyAntiCheat or BattlEye; GE tracks GE-Proton's own
    # releases for the games that want a GE-specific fix.
    #
    # Nothing here can dangle: finalize-repository.sh refuses to publish unless
    # every component produced a package, so a new dependency and the package it
    # names always reach the repository in the same release.
    'protonge-latest-bc250'
    'proton-cachyos-native-bc250'
    'proton-cachyos-slr-bc250'
)

package() {
    :
}
