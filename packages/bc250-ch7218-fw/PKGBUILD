# Maintainer: MastaG
#
# Opt-in and deliberately NOT a dependency of linux-cachyos-bc250-meta: it holds
# a firmware flasher, and nobody should have one installed by accident. Nothing
# in it runs on its own; flashing is a command a person types.
#
# Not derived from an upstream PKGBUILD. source= is the files next to this one:
# UGREEN's Linux updater (unmodified), UGREEN's 07.00.54 image (unmodified), two
# copies of it with one and two bytes changed, and UGREEN's later 07.00.69 image
# (unmodified) plus a one-byte fixed copy of it, see README.md. makepkg finds
# local sources by file name, so the build script copies firmware/* next to this
# file; in the repository they live in firmware/.
pkgname=bc250-ch7218-fw
pkgver=1
pkgrel=3
pkgdesc="UGREEN DP-to-HDMI 2.1 (Chrontel CH7218A) adapter: UGREEN's updater, the stock 07.00.54 firmware, two fixed images, UGREEN's newer 07.00.69 and a fixed copy of it, behind a manual flash wrapper"
arch=('x86_64')
url="https://github.com/MastaG/linux-cachyos-bc250"
license=('custom')
depends=('bash' 'python' 'util-linux' 'coreutils' 'gawk' 'glibc')
install=bc250-ch7218-fw.install
source=(
    'bc250-ch7218-flash'
    'ch7218_fwu'
    'README.md'
    'CH7218A-IMG.G000.07.00.54.IMG'
    'CH7218A-IMG.G000.07.00.54.nowatchdog-tmds.IMG'
    'CH7218A-IMG.G000.07.00.54.nowatchdog-tmds+frl.IMG'
    'CH7218A-IMG.G000.07.00.69.IMG'
    'CH7218A-IMG.G000.07.00.69.nowatchdog-tmds.IMG'
    'SHA256SUMS'
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')
# The updater is UGREEN's binary and must reach the user byte for byte.
options=('!strip' '!debug')

package() {
    install -Dm755 "$srcdir/bc250-ch7218-flash" "$pkgdir/usr/bin/bc250-ch7218-flash"
    install -Dm755 "$srcdir/ch7218_fwu" "$pkgdir/usr/lib/bc250-ch7218-fw/ch7218_fwu"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/bc250-ch7218-fw/README.md"
    local f
    for f in CH7218A-IMG.G000.07.00.54.IMG \
             CH7218A-IMG.G000.07.00.54.nowatchdog-tmds.IMG \
             CH7218A-IMG.G000.07.00.54.nowatchdog-tmds+frl.IMG \
             CH7218A-IMG.G000.07.00.69.IMG \
             CH7218A-IMG.G000.07.00.69.nowatchdog-tmds.IMG \
             SHA256SUMS; do
        install -Dm644 "$srcdir/$f" "$pkgdir/usr/share/bc250-ch7218-fw/firmware/$f"
    done
}
