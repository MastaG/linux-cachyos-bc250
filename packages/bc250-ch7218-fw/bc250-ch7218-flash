#!/bin/bash
# bc250-ch7218-flash: look at, and manually flash, the firmware of a UGREEN
# DP-to-HDMI 2.1 adapter (Chrontel CH7218A) with UGREEN's own Linux updater.
#
# Nothing here runs on its own: no service, no hook. Every flash is typed in by
# a person, behind the checks below. See /usr/share/doc/bc250-ch7218-fw/README.md.
set -u

LIBDIR="${BC250_CH7218_LIBDIR:-/usr/lib/bc250-ch7218-fw}"
IMGDIR="${BC250_CH7218_IMGDIR:-/usr/share/bc250-ch7218-fw/firmware}"
AUXDIR="${BC250_CH7218_AUXDIR:-/dev}"
STATE_DIR="${BC250_CH7218_STATE_DIR:-/var/lib/bc250-ch7218-fw}"
FWU="$LIBDIR/ch7218_fwu"

# The images are UGREEN's 07.00.54, two one/two-byte variants of it, and
# UGREEN's later 07.00.69, so the adapter must be on the same code line:
# 07.00.xx. Any build on that line up to the newest image we ship is accepted
# (going from 69 back to 54 is how you return to the tested firmware). A newer
# build we have not seen, a different line (07.08.xx, USB-C builds) or another
# vendor's firmware on this chip is not something to guess about, so it is refused.
VERSION_LINE="07:00"
VERSION_LATEST=69

# DPCD 0x500..0x508: the OUI 2B 02 F0 followed by the ASCII name "CH7218".
SIGNATURE="2b02f0434837323138"

die() { printf 'bc250-ch7218-flash: %s\n' "$*" >&2; exit 1; }

# 0 when $1 ("07:00:40") is on the 07.00 line and not newer than the images.
version_ok() {
    [[ "$1" =~ ^([0-9]+:[0-9]+):([0-9]+)$ ]] || return 1
    [[ "${BASH_REMATCH[1]}" == "$VERSION_LINE" ]] || return 1
    ((10#${BASH_REMATCH[2]} <= VERSION_LATEST))
}

image_file() {
    case "$1" in
        original) echo "CH7218A-IMG.G000.07.00.54.IMG" ;;
        tmds)     echo "CH7218A-IMG.G000.07.00.54.nowatchdog-tmds.IMG" ;;
        tmds-frl) echo "CH7218A-IMG.G000.07.00.54.nowatchdog-tmds+frl.IMG" ;;
        ugreen-69) echo "CH7218A-IMG.G000.07.00.69.IMG" ;;
        *) return 1 ;;
    esac
}

# The firmware version each image carries, as the updater reports it.
image_version() {
    case "$1" in
        ugreen-69) echo 69 ;;
        *) echo 54 ;;
    esac
}

image_blurb() {
    case "$1" in
        original) echo "UGREEN's own 07.00.54, unchanged. Use this to go back." ;;
        tmds)     echo "07.00.54 with the HDMI scrambling watchdog kept alive (1 byte). Running on the author's board." ;;
        tmds-frl) echo "tmds plus the FRL link monitor kept alive (2 bytes). NOT TESTED on hardware yet." ;;
        ugreen-69) echo "UGREEN's newer 07.00.69, unchanged (their answer to our report). Optional update; NOT TESTED by us yet." ;;
    esac
}

usage() {
    cat <<'USAGE'
Usage:
  bc250-ch7218-flash list                 the four firmware images
  sudo bc250-ch7218-flash status          find CH7218 adapters, read their firmware version
  sudo bc250-ch7218-flash flash IMAGE [--aux N] [--yes] [--dry-run]

IMAGE is one of: original | tmds | tmds-frl | ugreen-69      (see "list")

Flashing makes the adapter's HDMI output go dark for a moment and the new code
only runs after the adapter is power-cycled. Run it from SSH, not from the
screen the adapter drives, and do not cut power while it writes.
USAGE
}

# Read the identity bytes at DPCD 0x500 from one aux node.
dpcd_identity() {
    dd if="$1" bs=1 skip=$((0x500)) count=9 2>/dev/null | od -An -tx1 | tr -d ' \n'
}

# Print the aux node numbers that carry a CH7218, one per line.
find_adapters() {
    local node n
    for node in "$AUXDIR"/drm_dp_aux[0-9]*; do
        [[ -e "$node" ]] || continue
        n="${node##*drm_dp_aux}"
        [[ "$(dpcd_identity "$node")" == "$SIGNATURE" ]] && printf '%s\n' "$n"
    done
}

connector_of() {
    local link
    link="$(readlink -f "/sys/class/drm_dp_aux_dev/drm_dp_aux$1/device" 2>/dev/null)" || return 0
    basename "$link" 2>/dev/null | sed 's/^card[0-9]*-//'
}

# Run the vendor updater against exactly one aux node. The updater hard-codes
# /dev/drm_dp_aux1 and would otherwise touch whichever adapter happens to be
# there, so it runs in a private mount namespace whose /dev holds only the
# chosen node, under that name. Nothing outside the namespace changes.
run_fwu() {
    local n="$1"; shift
    local node="$AUXDIR/drm_dp_aux$n" major minor
    major=$((0x$(stat -c %t "$node")))
    minor=$((0x$(stat -c %T "$node")))
    unshare --mount --propagation private -- bash -c '
        set -e
        mount -t tmpfs -o mode=755 tmpfs /dev
        mknod -m 666 /dev/null c 1 3
        mknod -m 600 /dev/drm_dp_aux1 c "$1" "$2"
        shift 2
        exec "$@"
    ' _ "$major" "$minor" "$FWU" "$@"
}

read_version() {
    local out
    out="$(run_fwu "$1" -v 2>&1)" || true
    sed -nE 's/.*FW Version:[[:space:]]*([0-9]+:[0-9]+:[0-9]+).*/\1/p' <<<"$out" | head -1
}

expected_sha() {
    awk -v f="$1" '$2 == f || $2 == "*" f { print $1; exit }' "$IMGDIR/SHA256SUMS" 2>/dev/null
}

cmd_list() {
    local a f
    for a in original tmds tmds-frl ugreen-69; do
        f="$(image_file "$a")"
        printf '%-9s %s\n          %s\n          sha256 %s\n' "$a" "$f" "$(image_blurb "$a")" "$(expected_sha "$f")"
    done
}

cmd_status() {
    [[ "$EUID" -eq 0 ]] || die "status reads the DisplayPort AUX channel, which needs root: sudo bc250-ch7218-flash status"
    local found=0 n v
    while read -r n; do
        [[ -n "$n" ]] || continue
        found=1
        v="$(read_version "$n")"
        printf 'drm_dp_aux%s  connector %s  CH7218 firmware %s' "$n" "$(connector_of "$n")" "${v:-unreadable}"
        version_ok "$v" && printf '  (flashable with this tool)'
        printf '\n'
    done < <(find_adapters)
    if [[ -r "$STATE_DIR/last-flash" ]]; then
        printf 'last flash made by this tool: %s\n' "$(cat "$STATE_DIR/last-flash")"
        printf '(original, tmds and tmds-frl all report 07.00.54, so the version cannot tell those three apart)\n'
    fi
    ((found)) || { echo "no CH7218 adapter found (checked $AUXDIR/drm_dp_aux*)"; exit 1; }
}

# [length u16 LE][code][sum16 of bytes 2..length, LE, stored at offset length]:
# the same rule the vendor updater applies, checked here first.
image_is_sane() {
    python3 -I - "$1" <<'PY'
import sys
d = open(sys.argv[1], 'rb').read()
n = int.from_bytes(d[:2], 'little')
ok = len(d) == 65536 and 2 < n < len(d) - 2 and sum(d[2:n]) & 0xFFFF == int.from_bytes(d[n:n + 2], 'little')
sys.exit(0 if ok else 1)
PY
}

cmd_flash() {
    local alias="${1:-}" aux="" yes=0 dry=0 file path want have
    shift || true
    while (($#)); do
        case "$1" in
            --aux) aux="${2:-}"; shift ;;
            --yes) yes=1 ;;
            --dry-run) dry=1 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done
    file="$(image_file "$alias")" || die "IMAGE must be original, tmds, tmds-frl or ugreen-69 (see: bc250-ch7218-flash list)"
    path="$IMGDIR/$file"
    [[ "$EUID" -eq 0 ]] || die "flashing needs root: sudo bc250-ch7218-flash flash $alias"
    [[ -x "$FWU" ]] || die "the vendor updater is missing: $FWU"
    [[ -r "$path" ]] || die "image missing: $path"

    # The image must be exactly what the package shipped, and well-formed.
    want="$(expected_sha "$file")"
    have="$(sha256sum "$path" | awk '{print $1}')"
    [[ -n "$want" && "$want" == "$have" ]] || die "$file does not match SHA256SUMS: reinstall bc250-ch7218-fw"
    image_is_sane "$path" || die "$file fails the image length/checksum rule"

    local adapters
    mapfile -t adapters < <(find_adapters)
    if [[ -n "$aux" ]]; then
        [[ "$aux" =~ ^[0-9]+$ ]] || die "--aux takes a number, e.g. --aux 0"
        [[ "$(dpcd_identity "$AUXDIR/drm_dp_aux$aux" 2>/dev/null)" == "$SIGNATURE" ]] \
            || die "drm_dp_aux$aux is not a CH7218 adapter"
    else
        case "${#adapters[@]}" in
            0) die "no CH7218 adapter found" ;;
            1) aux="${adapters[0]}" ;;
            *) die "several CH7218 adapters (aux ${adapters[*]}): choose one with --aux N, see: bc250-ch7218-flash status" ;;
        esac
    fi

    local version
    version="$(read_version "$aux")"
    version_ok "$version" \
        || die "drm_dp_aux$aux reports firmware '${version:-unreadable}'. These images are for ${VERSION_LINE//:/.}.xx up to ${VERSION_LINE//:/.}.$VERSION_LATEST (older builds on that line are updated, newer ones are not downgraded). Not flashing."
    local upgrade_note="" target have_build
    target="$(image_version "$alias")"
    have_build=$((10#${version##*:}))
    if ((have_build < target)); then
        upgrade_note="This adapter is on an older build (${version//:/.}): flashing also brings it up to ${VERSION_LINE//:/.}.$target, as UGREEN's own update does."
    elif ((have_build > target)); then
        upgrade_note="This adapter is on a NEWER build (${version//:/.}) than this image (${VERSION_LINE//:/.}.$target): this is a downgrade."
    fi

    cat <<SUMMARY

About to flash:   $alias   ($file)
Adapter:          drm_dp_aux$aux  connector $(connector_of "$aux")  firmware $version
$(image_blurb "$alias")
${upgrade_note:+$upgrade_note
}
 - The adapter's HDMI output will go dark. If you are looking at that screen,
   stop and run this from SSH instead.
 - Do not power off or unplug anything until it says "Update Success".
 - The new code runs after the adapter is power-cycled (unplug its DisplayPort
   end for 5 seconds, or power the board off and on).
 - To go back at any time: flash "original".
SUMMARY
    if ((dry)); then
        echo "dry run: would run the vendor updater on drm_dp_aux$aux with: -f $path"
        exit 0
    fi
    if ((!yes)); then
        read -r -p 'Type "flash" to continue: ' reply
        [[ "${reply:-}" == flash ]] || die "cancelled, nothing was written"
    fi

    local out status
    out="$(run_fwu "$aux" -f "$path" 2>&1)"; status=$?
    printf '%s\n' "$out"
    if ((status == 0)) && grep -q 'Update Success' <<<"$out"; then
        mkdir -p "$STATE_DIR"
        printf '%s on drm_dp_aux%s at %s\n' "$alias" "$aux" "$(date '+%F %T')" > "$STATE_DIR/last-flash"
        echo
        echo "Flashed and verified. Power-cycle the adapter for the new firmware to run."
        exit 0
    fi
    cat >&2 <<'FAILED'

THE UPDATE DID NOT REPORT SUCCESS.
Do not power the adapter off yet. Run the same command again, or flash
"original", and look at the output above. The updater verifies by reading the
flash back, so a clean second run is the way to know it is good.
FAILED
    exit 1
}

case "${1:-}" in
    list) cmd_list ;;
    status) cmd_status ;;
    flash) shift; cmd_flash "$@" ;;
    -h|--help|help|"") usage ;;
    *) usage >&2; exit 2 ;;
esac
