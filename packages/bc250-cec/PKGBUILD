# Maintainer: MastaG
#
# Not derived from an upstream PKGBUILD and no separate source repository --
# small enough (one script, one unit) that a dedicated repo the way
# bc250-dual-audio has one would be pure overhead. Same shape as
# linux-cachyos-bc250-meta: entirely our own, source= is local files sitting
# next to this PKGBUILD.
pkgname=bc250-cec
pkgver=1
pkgrel=16
pkgdesc="BC-250 HDMI CEC: identify as SteamOS on the CEC bus and retrain the display link when the display powers on or switches to it"
arch=('any')
url="https://github.com/MastaG/linux-cachyos-bc250"
license=('GPL-2.0-only')
depends=('v4l-utils' 'bash' 'python' 'python-evdev')
install=bc250-cec.install
backup=('etc/bc250-cec.conf')
source=(
    'bc250-cec-daemon.sh'
    'bc250-cec.service'
    'bc250-cec.conf'
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
    install -Dm755 "$srcdir/bc250-cec-daemon.sh" \
        "$pkgdir/usr/lib/bc250-cec/bc250-cec-daemon.sh"
    install -Dm644 "$srcdir/bc250-cec.service" \
        "$pkgdir/usr/lib/systemd/system/bc250-cec.service"
    install -Dm644 "$srcdir/bc250-cec.conf" \
        "$pkgdir/etc/bc250-cec.conf"
}
