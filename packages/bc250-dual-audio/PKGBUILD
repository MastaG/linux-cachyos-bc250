# Maintainer: MastaG
pkgname=bc250-dual-audio
pkgver=0.10
pkgrel=1
pkgdesc="Dual-output audio policy for the AMD BC-250: native HDMI/DP plus switchable Dolby Digital 5.1 (AC3) and Dolby Digital Plus 5.1 (E-AC3) virtual sinks"
arch=('any')
url="https://github.com/MastaG/bc250-dual-audio"
license=('custom')
depends=('wireplumber' 'pipewire' 'alsa-plugins' 'ffmpeg' 'alsa-utils')
backup=(
    'etc/alsa/conf.d/61-bc250-a52.conf'
    'etc/pipewire/pipewire.conf.d/60-bc250-ac3-output.conf'
    'etc/wireplumber/wireplumber.conf.d/50-bc250-audio.conf'
)
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')
install=bc250-dual-audio.install

package() {
    cd "$srcdir/$pkgname"

    install -Dm644 etc/alsa/conf.d/61-bc250-a52.conf \
        "$pkgdir/etc/alsa/conf.d/61-bc250-a52.conf"
    install -Dm644 etc/pipewire/pipewire.conf.d/60-bc250-ac3-output.conf \
        "$pkgdir/etc/pipewire/pipewire.conf.d/60-bc250-ac3-output.conf"
    install -Dm644 etc/wireplumber/wireplumber.conf.d/50-bc250-audio.conf \
        "$pkgdir/etc/wireplumber/wireplumber.conf.d/50-bc250-audio.conf"

    # 90-bc250-audio-mode.lua is a filename of our own choosing and the
    # wireplumber package ships nothing under it, so it installs as a normal
    # package-owned file under the standard system script tree.
    install -Dm644 usr/local/share/wireplumber/scripts/90-bc250-audio-mode.lua \
        "$pkgdir/usr/share/wireplumber/scripts/90-bc250-audio-mode.lua"

    # monitors/alsa.lua cannot move to /usr/share: the wireplumber package's
    # own stock config hardcodes `name = monitors/alsa.lua, provides =
    # monitor.alsa`, and owns that exact path, so installing our copy there
    # would overwrite a pacman-owned file. A different filename doesn't work
    # either -- verified: WirePlumber refuses to start at all when two
    # components both declare `provides = monitor.alsa` ("no component
    # provides 'monitor.alsa'"), rather than picking one. /usr/local/share
    # ahead of /usr/share in XDG_DATA_DIRS is the only mechanism this
    # WirePlumber offers for shadowing one stock script under its original
    # name without touching the package that owns it.
    install -Dm644 usr/local/share/wireplumber/scripts/monitors/alsa.lua \
        "$pkgdir/usr/local/share/wireplumber/scripts/monitors/alsa.lua"

    install -Dm755 check.sh "$pkgdir/usr/share/bc250-dual-audio/check.sh"

    install -Dm644 README.md \
        "$pkgdir/usr/share/doc/$pkgname/README.md"

    # bc250-eac3-backend.service hardcodes ExecStart=/usr/local/libexec/... ,
    # and install.sh/rollback.sh use that same literal path for their
    # backup/restore logic. Keep the binary there so a pacman install and a
    # manual install.sh run stay interchangeable and the shipped unit file
    # needs no content edits at package time.
    install -Dm755 usr/local/libexec/bc250-eac3-backend \
        "$pkgdir/usr/local/libexec/bc250-eac3-backend"

    # The unit file itself is a vendor file with no reason to live in the
    # admin-override tier: /usr/lib/systemd/user is systemd's actual search
    # path for package-owned user units (matching wireplumber.service and
    # friends), unlike /etc/systemd/user (local overrides) which the repo
    # layout uses only because that's a sensible path for install.sh's
    # unmanaged, non-pacman install. Only the directory changes here -- the
    # file's own content, including its /usr/local/libexec ExecStart=, ships
    # unmodified.
    install -Dm644 etc/systemd/user/bc250-eac3-backend.service \
        "$pkgdir/usr/lib/systemd/user/bc250-eac3-backend.service"
}
