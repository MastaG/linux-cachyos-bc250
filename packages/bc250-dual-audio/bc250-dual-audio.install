_EXPECTED_WP_VERSION=0.5.17
# sha256 of the stock WirePlumber 0.5.17 monitors/alsa.lua that this package's
# override is rebased onto. Mirrors the same check upstream's install.sh does:
# the override is a full replacement of that script, so applying it on top of an
# unknown base is how it silently stops matching the running WirePlumber.
_EXPECTED_STOCK_ALSA_SHA256=b0f15addcd2b36a8a5cd87555b9cbd822de1b8663545e5add2faf3d2f4c50211
_STOCK_ALSA=/usr/share/wireplumber/scripts/monitors/alsa.lua

_check_wireplumber() {
    local ver stock

    ver=$(wireplumber --version 2>/dev/null | grep -Eo '0\.5\.[0-9]+' | head -1)
    if [ -n "$ver" ] && [ "$ver" != "$_EXPECTED_WP_VERSION" ]; then
        echo "==> WARNING: this policy is rebased and tested against WirePlumber"
        echo "==>          $_EXPECTED_WP_VERSION. Detected: $ver"
        echo "==>          The dual-audio policy may not work correctly."
    fi

    if [ -f "$_STOCK_ALSA" ]; then
        stock=$(sha256sum "$_STOCK_ALSA" 2>/dev/null | awk '{print $1}')
        if [ -n "$stock" ] && [ "$stock" != "$_EXPECTED_STOCK_ALSA_SHA256" ]; then
            echo "==> WARNING: the stock WirePlumber ALSA monitor is not the"
            echo "==>          $_EXPECTED_WP_VERSION base this override was rebased onto."
            echo "==>          Expected: $_EXPECTED_STOCK_ALSA_SHA256"
            echo "==>          Found:    $stock"
            echo "==>          Native HDMI/AC3 switching may misbehave until this"
            echo "==>          package is rebased onto the current WirePlumber."
        fi
    fi
}

_restart_reminder() {
    echo "==> Restart the audio stack (or reboot) for this to take effect:"
    echo "==>   systemctl --user restart pipewire pipewire-pulse wireplumber"
    echo "==> Then check the result with:"
    echo "==>   /usr/share/bc250-dual-audio/check.sh"
}

# v0.14 removed E-AC-3. pacman drops the files this package used to own, but
# the unit may still be enabled and running in the desktop user's session, and
# a saved default sink may still name bc250_eac3 -- which no longer exists.
# This scriptlet runs as root at transaction time with no access to that
# session bus, so neither can be fixed here; say so instead of leaving a
# half-removed feature behind. Printed only when upgrading from a version that
# had it.
_eac3_retired() {
    echo "==> E-AC3 (Dolby Digital Plus) has been removed in v0.14: the external"
    echo "==>   encoder service added latency that could not be designed out."
    echo "==>   AC-3 now runs at 640 kbps, its maximum."
    echo "==> Retire the old service in your own session:"
    echo "==>   systemctl --user disable --now bc250-eac3-backend.service"
    echo "==>   systemctl --user daemon-reload"
    echo "==> If your selected output was 'Dolby Digital Plus 5.1', pick"
    echo "==>   'Dolby Digital 5.1 (AC3)' again -- the old sink is gone."
}

post_install() {
    _check_wireplumber
    echo "==> BC-250 dual-output audio policy installed."
    _restart_reminder
}

post_upgrade() {
    local oldver=$2

    _check_wireplumber
    echo "==> BC-250 dual-output audio policy updated."
    _restart_reminder

    # $2 is the version being upgraded from. Anything below 0.14 shipped E-AC-3.
    if [ -n "$oldver" ] && \
       [ "$(printf '%s\n0.14\n' "$oldver" | sort -V | head -1)" = "$oldver" ] && \
       [ "$oldver" != "0.14" ]; then
        _eac3_retired
    fi
}

post_remove() {
    echo "==> BC-250 dual-output audio policy removed."
    echo "==> The stock WirePlumber ALSA monitor (owned by the wireplumber"
    echo "==> package) was never modified and is unaffected."
    _restart_reminder
}
