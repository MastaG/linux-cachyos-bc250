# Maintainer: MastaG
#
# Small corrections for things other packages get wrong on a BC-250, applied by
# one pacman hook running one script. Entirely our own, no upstream source:
# source= is the local files next to this PKGBUILD, same shape as
# bc250-paccache-cleanup. It is a dependency of linux-cachyos-bc250-meta, and
# pkgrel must be bumped whenever bc250-fixes.sh gains a fix so that installed
# systems pick it up on the next update.
pkgname=bc250-fixes
pkgver=1
pkgrel=2
pkgdesc="Small BC-250 corrections for other packages, applied by a pacman hook (Return to Gaming Mode shortcut, Steam beta tool path)"
arch=('any')
url="https://github.com/MastaG/linux-cachyos-bc250"
license=('GPL-2.0-only')
depends=()
install=bc250-fixes.install
source=('bc250-fixes.sh'
        'bc250-fixes.hook'
        'bc250-fixes.tmpfiles')
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
    install -Dm755 "$srcdir/bc250-fixes.sh" \
        "$pkgdir/usr/lib/bc250-fixes/bc250-fixes.sh"
    install -Dm644 "$srcdir/bc250-fixes.hook" \
        "$pkgdir/usr/share/libalpm/hooks/bc250-fixes.hook"
    install -Dm644 "$srcdir/bc250-fixes.tmpfiles" \
        "$pkgdir/usr/lib/tmpfiles.d/bc250-fixes.conf"
}
