# END generated by rocm/update-pkgbuild.sh
pkgver=${_torch}.rocm${_rocm//.dev/dev}
pkgrel=1
pkgdesc="PyTorch $_torch with ROCm for the BC-250 GPU (gfx1013), in a standalone Python under /opt/bc250-pytorch"
arch=('x86_64')
url="https://github.com/MastaG/linux-cachyos-bc250"
license=('BSD-3-Clause' 'MIT' 'Apache-2.0' 'PSF-2.0')
depends=('glibc' 'gcc-libs')
optdepends=('uv: quicker venvs on top of /opt/bc250-pytorch')
# ROCm libraries carry GPU code objects; keep every .so exactly as built.
options=('!strip' '!debug')
_release="https://github.com/MastaG/linux-cachyos-bc250/releases/download/rocm-pytorch"
source=(
    "https://github.com/astral-sh/python-build-standalone/releases/download/$_pbs/cpython-$_py+$_pbs-x86_64-unknown-linux-gnu-install_only.tar.gz"
    'bc250-rocm-env.pth'
    'bc250-pytorch-check'
    'EXTERNALLY-MANAGED'
    'README.md'
)
sha256sums=('c2f87d4b4e8db3abddb0f116c6ccfc503d0cbdbb9ee8faacddad1b679ec12e99'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')
noextract=("cpython-$_py+$_pbs-x86_64-unknown-linux-gnu-install_only.tar.gz")
for _w in "${_wheels[@]}"; do
    # Release assets carry the build id so builds never overwrite each other.
    source+=("$_w::$_release/$_build_id--$_w")
    noextract+=("$_w")
done
sha256sums+=("${_wheel_sums[@]}")
unset _w

package() {
    local opt=/opt/bc250-pytorch dest="$pkgdir/opt/bc250-pytorch"
    local site="$dest/lib/python3.12/site-packages"
    (( ${#_wheels[@]} )) || { echo "no wheels listed: run rocm/update-pkgbuild.sh first" >&2; return 1; }

    install -d "$dest"
    bsdtar -xf "cpython-$_py+$_pbs-x86_64-unknown-linux-gnu-install_only.tar.gz" \
        --strip-components 1 -C "$dest"

    # Offline, from exactly the wheels above.
    PYTHONDONTWRITEBYTECODE=1 "$dest/bin/python3" -m pip install --no-index --find-links "$srcdir" \
        --no-compile --no-warn-script-location --disable-pip-version-check --root-user-action=ignore \
        "rocm[libraries,device]==$_rocm" "torch==$_torch" torchvision torchaudio

    # pip wrote the build path into script shebangs; point them at /opt.
    grep -rlI "^#!$dest/" "$dest/bin" | xargs -r sed -i "1s|^#!$dest/|#!$opt/|"
    # Byte-compile now, with /opt paths: users can't write to /opt at runtime.
    # -f: rewrite everything, also the stdlib .pyc files running pip already made.
    PYTHONDONTWRITEBYTECODE=1 "$dest/bin/python3" -m compileall -f -q -j0 -s "$pkgdir" -p / "$dest/lib/python3.12" >/dev/null || true

    install -m644 bc250-rocm-env.pth "$site/"
    install -m644 EXTERNALLY-MANAGED "$dest/lib/python3.12/"
    install -m755 bc250-pytorch-check "$dest/bin/"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -d "$pkgdir/usr/bin"
    ln -s "$opt/bin/python3" "$pkgdir/usr/bin/bc250-python"
    ln -s "$opt/bin/bc250-pytorch-check" "$pkgdir/usr/bin/bc250-pytorch-check"
}
