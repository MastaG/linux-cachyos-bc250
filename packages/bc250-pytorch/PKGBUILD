# Maintainer: MastaG
#
# PyTorch with ROCm built for the BC-250 (gfx1013), in its own Python under
# /opt/bc250-pytorch. It does not use the system Python or any system ROCm
# package, so CachyOS Python/ROCm updates neither break it nor need a rebuild.
# Apps use it through a venv:
#   /opt/bc250-pytorch/bin/python3 -m venv --system-site-packages ~/app/venv
#
# Opt-in, not part of linux-cachyos-bc250-meta.
#
# The wheels are built by rocm/build-rocm.sh (workflow "ROCm and PyTorch
# wheels", started by hand) and published on the rocm-pytorch release; the
# block between the markers is written by rocm/update-pkgbuild.sh <build id>.
pkgname=bc250-pytorch
_py=3.12.16
_pbs=20261110
# BEGIN generated by rocm/update-pkgbuild.sh
_build_id=d3f4c5511f68
_torch=2.13.0
_rocm=10.3.0.dev0
_wheels=(
    'filelock-4.2.10-py3-none-any.whl'
    'fsspec-2026.9.0-py3-none-any.whl'
    'jinja2-3.1.6-py3-none-any.whl'
    'markupsafe-3.0.4-cp312-cp312-manylinux2014_x86_64.manylinux_2_17_x86_64.manylinux_2_28_x86_64.whl'
    'mpmath-1.3.0-py3-none-any.whl'
    'networkx-3.7-py3-none-any.whl'
    'numpy-2.5.4-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl'
    'pillow-13.0.0-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl'
    'rocm-10.3.0.dev0-py3-none-any.whl'
    'rocm_sdk_core-10.3.0.dev0-py3-none-linux_x86_64.whl'
    'rocm_sdk_device_gfx1013-10.3.0.dev0-py3-none-linux_x86_64.whl'
    'rocm_sdk_libraries-10.3.0.dev0-py3-none-linux_x86_64.whl'
