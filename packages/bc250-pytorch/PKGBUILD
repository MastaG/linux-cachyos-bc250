    'torchaudio-2.11.0.2+devrocm10.3.0.dev0-cp312-cp312-linux_x86_64.whl'
    'torchvision-0.28.0+devrocm10.3.0.dev0-cp312-cp312-linux_x86_64.whl'
    'typing_extensions-4.16.0-py3-none-any.whl'
)
