#!/usr/bin/env python3
"""Add the PS5 games in a folder to Steam as KytyPS5-Native shortcuts.

Every subfolder of the games folder (default ~/Games/PS5) is one game, for
example ~/Games/PS5/PPSA21564-app0. The name and the artwork come from the game
itself:

  name    sce_sys/param.json -> localizedParameters/<lang>/titleName  (+ " (PS5)")
  art     sce_sys/pic0.png   -> grid/<appid>.png and grid/<appid>_hero.png
          sce_sys/icon0.png  -> grid/<appid>_icon.png (also the shortcut icon)
                              and grid/<appid>p.png when the game has no poster art
  launch  "/usr/bin/kytyps5-run" "<game folder>" [--keep-steam]

Nothing is done twice: a folder that already has a shortcut keeps that shortcut
(its artwork is re-copied when the game's own pictures changed) and only new
folders are added. For a shortcut whose game folder is gone you are asked
whether to remove it (and the artwork it had); --prune removes them all
without asking, and without a terminal they are kept.

Steam reads its shortcut list when it starts, so Steam has to be closed while
this writes it; the script asks to stop it and starts it again afterwards, and
backs the list up next to itself first. Artwork alone needs no restart.

Examples:
  kytyps5-steam-sync                    add the new games in ~/Games/PS5
  kytyps5-steam-sync /mnt/games/ps5     the same for another folder
  kytyps5-steam-sync --prune            remove shortcuts of removed games without asking
  kytyps5-steam-sync --list             show the games, the shortcuts and what differs
  kytyps5-steam-sync --dry-run          show what would happen, change nothing
  kytyps5-steam-sync --yes              stop and restart Steam without asking
  kytyps5-steam-sync --art-only         only re-copy artwork from the game folders

After adding: turn Steam Input OFF for the new shortcuts in Steam, or Kyty only
sees Steam's virtual pad (no motion controls, haptics, adaptive triggers).
"""

import argparse
import collections
import hashlib
import json
import os
import re
import shlex
import shutil
import struct
import subprocess
import sys
import time

DEFAULT_RUNNER = '/usr/bin/kytyps5-run'
GAME_SUFFIX = ' (PS5)'
PREFERRED_LANG = 'en-US'
STATE_NAME = '.kytyps5-steam-sync.json'
OLD_STATE_NAMES = ('.ps5-steam.json',)
DEFAULT_GAMES_DIR = '~/Games/PS5'
STEAM_UNIT = 'steam-launcher.service'
RUNNER_NAMES = ('kytyps5-run', 'kytyps5-run.sh')
ART_NAMES = ('%s.png', '%s_hero.png', '%s_icon.png', '%sp.png')

# --------------------------------------------------------------- shortcuts.vdf
# Binary VDF: 0x00 section (name NUL, body until 0x08), 0x01 string (name NUL,
# value NUL), 0x02 int32 LE (name NUL, 4 bytes), 0x08 ends the current section.
# A shortcuts.vdf carries one 0x08 more than its sections need; keep it byte for
# byte or Steam rewrites the whole file on its next start.
END, SEC, STR, INT = 0x08, 0x00, 0x01, 0x02


def _cstr(buf, off):
    end = buf.index(b'\x00', off)
    return buf[off:end].decode('utf-8', 'surrogateescape'), end + 1


def vdf_parse(buf, off=0, end=None):
    """-> (OrderedDict of the section's members, offset past its 0x08)."""
    if end is None:
        end = len(buf)
    out = collections.OrderedDict()
    while off < end:
        t = buf[off]
        if t == END:
            return out, off + 1
        if t not in (SEC, STR, INT):
            raise ValueError('unknown type %02x at offset %d' % (t, off))
        name, off = _cstr(buf, off + 1)
        if t == SEC:
            val, off = vdf_parse(buf, off, end)
        elif t == STR:
            val, off = _cstr(buf, off)
        else:
            val = struct.unpack('<i', buf[off:off + 4])[0]
            off += 4
        key, n = name, 2
        while key in out:                       # keep a repeated key, never drop it
            key, n = '%s#%d' % (name, n), n + 1
        out[key] = val
    raise ValueError('section at offset %d has no end byte' % off)


def vdf_serialize(members):
    out = bytearray()
    for key, val in members:
        kb = str(key).encode('utf-8', 'surrogateescape')
        if b'\x00' in kb:
            raise ValueError('NUL in key %r' % key)
        if isinstance(val, dict):
            out += bytes([SEC]) + kb + b'\x00' + \
                vdf_serialize(list(val.items())) + bytes([END])
        elif isinstance(val, int):
            out += bytes([INT]) + kb + b'\x00' + struct.pack('<i', val)
        else:
            vb = ('' if val is None else str(val)).encode('utf-8', 'surrogateescape')
            if b'\x00' in vb:
                raise ValueError('NUL in the value of %r' % key)
            out += bytes([STR]) + kb + b'\x00' + vb + b'\x00'
    return bytes(out)


def vdf_read(path):
    """-> (top, entries). Refuses to guess: the file has to round-trip byte for
    byte before it is rewritten, so any layout we do not know stops us here."""
    with open(path, 'rb') as fh:
        data = fh.read()
    try:
        top, _ = vdf_parse(data)
        again = vdf_serialize(list(top.items())) + b'\x08'
    except ValueError as exc:
        raise SystemExit('%s: %s -- not a shortcuts.vdf this script knows' % (path, exc))
    if again != data:
        raise SystemExit('%s parses to something that is not the same file, refusing to '
                         'rewrite it (Steam may still be writing it)' % path)
    entries = top.get('shortcuts')
    if not isinstance(entries, dict):
        raise SystemExit('%s has no "shortcuts" section' % path)
    return top, entries


def vdf_write(path, top):
    blob = vdf_serialize(list(top.items())) + b'\x08'
    st = os.stat(path)
    tmp = '%s.tmp-%d' % (path, os.getpid())
    with open(tmp, 'wb') as fh:
        fh.write(blob)
        fh.flush()
        os.fsync(fh.fileno())
    os.chmod(tmp, st.st_mode & 0o7777)
    try:
        os.chown(tmp, st.st_uid, st.st_gid)
    except OSError:
        pass
    os.replace(tmp, path)
    return blob


def quote(path):
    """The hand made shortcuts store these three fields with quotes around the
    path; Steam starts them like that, so copy it exactly."""
    return '"%s"' % path


def unquote(value):
    value = (value or '').strip()
    if len(value) > 1 and value.startswith('"') and value.endswith('"'):
        return value[1:-1]
    return value


# ------------------------------------------------------------------------ steam
def steam_roots():
    home = os.path.expanduser('~')
    cands = []
    if os.environ.get('STEAM_PATH'):
        cands.append(os.environ['STEAM_PATH'])
    cands += [os.path.join(home, '.local/share/Steam'),
              os.path.join(home, '.steam/root'),
              os.path.join(home, '.steam/debian-installation')]
    # On SteamOS these are one and the same install reached by different names;
    # keep the real path, it is what the shortcuts' own icon paths already use.
    seen, out = set(), []
    for cand in cands:
        real = os.path.realpath(cand)
        if os.path.isdir(real) and real not in seen:
            seen.add(real)
            out.append(real)
    return out


def find_shortcuts_vdf(want_user=None):
    """-> (userdata id, path). With several accounts: the one with the longest list."""
    scored = []
    for root in steam_roots():
        ud = os.path.join(root, 'userdata')
        for user in sorted(os.listdir(ud)) if os.path.isdir(ud) else []:
            if want_user and user != want_user:
                continue
            path = os.path.join(ud, user, 'config/shortcuts.vdf')
            if not os.path.isfile(path):
                continue
            try:
                _, entries = vdf_read(path)
            except SystemExit as exc:
                print('  ! %s' % exc)
                continue
            scored.append((len(entries), os.path.getmtime(path), user, path))
    if not scored:
        raise SystemExit('no usable shortcuts.vdf under %s -- is Steam installed?'
                         % (', '.join(steam_roots()) or '~/.local/share/Steam'))
    scored.sort(reverse=True)
    return scored[0][2], scored[0][3]


def _run(cmd, timeout=30):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ''


def steam_unit_active():
    """True when Steam runs as the gamescope session's steam-launcher.service."""
    return _run(['systemctl', '--user', 'is-active', STEAM_UNIT]) == 'active'


def steam_processes():
    """This user's Steam client processes (a desktop Steam has no unit)."""
    pids = []
    for name in ('steam', 'steamwebhelper'):
        for pid in _run(['pgrep', '-x', name]).split():
            try:
                if os.stat('/proc/%s' % pid).st_uid == os.getuid():
                    pids.append(pid)
            except OSError:
                continue
    return pids


def steam_is_running():
    return steam_unit_active() or bool(steam_processes())


def steam_stop(wait=60):
    """-> how to start it again ('unit', 'desktop') or None when it did not stop."""
    how = 'unit' if steam_unit_active() else 'desktop'
    if how == 'unit':
        _run(['systemctl', '--user', 'stop', STEAM_UNIT], timeout=wait)
    else:
        steam = shutil.which('steam')
        if steam:
            subprocess.Popen([steam, '-shutdown'], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time.time() + wait
    while time.time() < deadline:
        if not steam_is_running():
            return how
        time.sleep(1)
    return None if steam_is_running() else how


def steam_start(how):
    if how == 'unit':
        # kytyps5-run masks the unit while a game runs, so unmask before starting.
        _run(['systemctl', '--user', 'unmask', '--runtime', STEAM_UNIT])
        _run(['systemctl', '--user', 'start', STEAM_UNIT])
        return
    steam = shutil.which('steam')
    if steam:
        subprocess.Popen([steam], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def appid_for(appname, exe, startdir, lo, taken):
    """A fresh id in the shape Steam gives its shortcuts (bit 31 set). Should
    Steam hand the shortcut another id when it first reads the list, the next run
    takes the id out of the list again and moves the artwork to match."""
    seed = '\x1f'.join((appname, exe, startdir, lo)).encode('utf-8', 'surrogateescape')
    x = int.from_bytes(hashlib.md5(seed).digest()[:4], 'big')
    x = ((x >> 15) | (x << 17)) & 0xffffffff
    x = (x >> 1) | 0x80000000
    while x in taken:
        x = ((x + 1) & 0x7fffffff) | 0x80000000
    taken.add(x)
    return x


# ------------------------------------------------------------------- game folder
def image_size(path):
    """(w, h) from the file header alone; None when we cannot tell."""
    try:
        with open(path, 'rb') as fh:
            head = fh.read(32)
    except OSError:
        return None
    try:
        if head[:8] == b'\x89PNG\r\n\x1a\n':
            return struct.unpack('>II', head[16:24])
        if head[:4] == b'DDS ':                       # 12 height, 16 width
            h, w = struct.unpack('<II', head[12:20])
            return w, h
        if head[:2] == b'\xff\xd8':                   # jpeg: walk the segments
            with open(path, 'rb') as fh:
                fh.read(2)
                while True:
                    marker = fh.read(2)
                    if len(marker) < 2 or marker[0] != 0xFF:
                        return None
                    if 0xC0 <= marker[1] <= 0xCF and marker[1] not in (0xC4, 0xC8, 0xCC):
                        fh.read(3)
                        h, w = struct.unpack('>HH', fh.read(4))
                        return w, h
                    fh.seek(struct.unpack('>H', fh.read(2))[0] - 2, os.SEEK_CUR)
    except (OSError, struct.error, ValueError):
        return None
    return None


def install_image(src, dst):
    """Byte copy when the game's own picture already is a picture Steam reads; a
    .dds goes through Pillow, which the board has (and keeps the copy honest:
    the ASTRO BOT artwork in the grid folder is a byte copy of the game's pic0)."""
    if not src.lower().endswith('.dds'):
        shutil.copyfile(src, dst)
        return 'copied'
    from PIL import Image
    im = Image.open(src)
    im.load()
    if im.mode not in ('RGB', 'RGBA', 'L'):
        im = im.convert('RGBA')
    tmp = dst + '.tmp'
    im.save(tmp, 'PNG')
    os.replace(tmp, dst)
    return 'converted'


class Game(object):
    """One PS5 game folder; its name and its art come from what is inside it."""

    def __init__(self, path, lang=None):
        self.dir = path
        self.path = os.path.realpath(path)
        self.title_id = os.path.basename(self.path)
        self.param = self._param()
        self.lang, self.title = self._title(lang)

    def _param(self):
        p = os.path.join(self.dir, 'sce_sys/param.json')
        if os.path.isfile(p):
            try:
                with open(p, encoding='utf-8', errors='replace') as fh:
                    return json.load(fh)
            except ValueError as exc:
                print('  ! %s: %s' % (p, exc))
        return {}

    def _title(self, lang):
        loc = self.param.get('localizedParameters') or {}
        for try_lang in [lang, os.environ.get('LANGUAGE', '').split(':')[0],
                         os.environ.get('LC_ALL', '').split('.')[0],
                         PREFERRED_LANG] + list(loc):
            if try_lang and isinstance(loc.get(try_lang), dict) and loc[try_lang].get('titleName'):
                return try_lang, loc[try_lang]['titleName'].strip()
        if self.param.get('titleId'):
            return None, self.param['titleId']
        return None, re.sub(r'-app\d*$', '', self.title_id) or self.title_id

    def appname(self, suffix):
        return (self.title + suffix)[:120]

    def looks_installed(self):
        return bool(self.param) or os.path.isfile(os.path.join(self.dir, 'eboot.bin'))

    def images(self):
        """(icon, landscape, portrait) inside the game folder, any of them None."""
        if getattr(self, '_images', None) is not None:
            return self._images
        found = []
        for sub in ('sce_sys', '.'):
            d = os.path.join(self.dir, sub)
            if os.path.isdir(d):
                found += [os.path.join(d, f) for f in sorted(os.listdir(d))
                          if re.match(r'(?i)^(icon0|pic0|pic1|pic2)\.(png|jpg|jpeg|webp|dds)$', f)]
        icon = pick_image(found, r'/icon0\.')
        landscape = pick_image(found, r'/pic0\.')
        portrait = pick_image(found, r'/pic1\.')
        size = image_size(portrait) if portrait else None
        if portrait and not (size and size[1] > size[0]):
            portrait = None            # a pic1 that is not vertical is just more wallpaper
        self._images = (icon, landscape, portrait)
        return self._images


def pick_image(paths, pattern):
    """Prefer a picture Steam reads directly over a .dds that has to be converted."""
    hits = [p for p in paths if re.search(pattern, p)]
    for ext in ('.png', '.jpg', '.jpeg', '.webp', '.dds'):
        for p in hits:
            if p.lower().endswith(ext):
                return p
    return hits[0] if hits else None


def md5(path):
    h = hashlib.md5()
    try:
        with open(path, 'rb') as fh:
            for chunk in iter(lambda: fh.read(1 << 20), b''):
                h.update(chunk)
    except OSError:
        return None
    return h.hexdigest()


def art_wanted(appid, game):
    """[(source, grid file name)] like the ASTRO BOT entry: pic0 for the grid and
    the hero, icon0 for the icon and (when the game has no vertical art) the poster."""
    icon, landscape, portrait = game.images()
    want = []
    if landscape:
        want += [(landscape, ART_NAMES[0] % appid), (landscape, ART_NAMES[1] % appid)]
    if icon:
        want.append((icon, ART_NAMES[2] % appid))
    poster = portrait or icon
    if poster:
        want.append((poster, ART_NAMES[3] % appid))
    return want


def shortcut_icon(appid, grid_dir, game):
    """Where this shortcut's icon lives once the game's own icon0 is copied, or
    None when the game has no icon to copy -- then the icon field is left alone,
    it may point at a picture the owner put there by hand."""
    name = ART_NAMES[2] % appid
    if not any(n == name for _, n in art_wanted(appid, game)):
        return None
    return os.path.join(grid_dir, name)


def sync_art(appid, game, grid_dir, state, force=False, say=print):
    """Put this game's pictures in Steam's grid folder under its current appid and
    remove the ones this script made for an older appid of the same shortcut.
    -> (kept, written, removed, missing sources)"""
    keep, written, removed = [], [], []
    rec = state.get(game.path) or {}
    want = art_wanted(appid, game)
    if not want:
        return keep, written, removed, True
    sources = {}
    for src, name in want:
        dst = os.path.join(grid_dir, name)
        src_sum = md5(src)
        sources[name] = src_sum
        # content decides: art the owner placed by hand in exactly this shape (the
        # ASTRO BOT case) is adopted, and a picture converted from a .dds is kept
        # as long as its source has not changed
        if not force and os.path.isfile(dst) and (
                md5(dst) == src_sum or (rec.get('sources') or {}).get(name) == src_sum):
            keep.append(name)
            continue
        try:
            how = install_image(src, dst)
        except Exception as exc:
            say('    ! %s: %s (%s)' % (name, type(exc).__name__, exc))
            continue
        written.append((how, name, os.path.relpath(src, game.dir)))
        keep.append(name)
    made = set(rec.get('files') or [])
    if rec.get('appid'):
        made |= {name % rec['appid'] for name in ART_NAMES}
    for name in sorted(made - set(keep)):
        path = os.path.join(grid_dir, name)
        if os.path.isfile(path) or os.path.islink(path):
            os.remove(path)
            removed.append(name)
    state[game.path] = {'appid': appid, 'title': game.title, 'files': sorted(set(keep)),
                        'sources': {n: sources[n] for n in sorted(set(keep)) if n in sources}}
    for how, name, src in written:
        say('    %s %s <- %s' % (how, name, src))
    if removed:
        say('    removed stale %s' % ', '.join(removed))
    return keep, written, removed, False


def forget_art(game_path, appid, grid_dir, state, say=print):
    """Delete the grid files of a shortcut that goes away: the ones this script
    made for it, or, for a shortcut it has no record of, the standard artwork
    names of that shortcut's appid (no other shortcut uses that appid)."""
    rec = state.pop(game_path, None) or {}
    names = set(rec.get('files') or []) or {name % appid for name in ART_NAMES}
    if rec.get('appid'):
        names |= {name % rec['appid'] for name in ART_NAMES}
    full64 = ((appid << 32) | 0x02000000) & 0xFFFFFFFFFFFFFFFF
    for name in sorted(names):
        path = os.path.join(grid_dir, name)
        if os.path.isfile(path) or os.path.islink(path):
            os.remove(path)
            say('    - %s' % name)
    link = os.path.join(grid_dir, '%d.png' % full64)
    if os.path.islink(link):
        os.remove(link)
        say('    - %s (symlink)' % os.path.basename(link))


# ---------------------------------------------------------------- the shortcuts
def entry_appid(entry):
    return int(entry.get('appid', 0)) & 0xffffffff


def is_kyty_entry(entry):
    return os.path.basename(unquote(entry.get('exe', ''))) in RUNNER_NAMES


def entry_game_path(entry):
    """The game folder a kytyps5-run shortcut starts, out of its launch options."""
    lo = unquote(entry.get('LaunchOptions', ''))
    try:
        toks = shlex.split(lo)
    except ValueError:
        toks = lo.split()
    for tok in toks:
        if tok.startswith(('/', '~', '.')) or tok.lower().endswith('.zar'):
            return os.path.abspath(os.path.expanduser(tok))
    return None


def new_entry(appid, appname, runner, game_path, keep_steam, icon_path):
    """Same fields in the same order as the hand made ASTRO BOT shortcut."""
    e = collections.OrderedDict()
    e['appid'] = appid - 0x100000000 if appid >= 0x80000000 else appid
    e['appname'] = appname
    e['exe'] = quote(runner)
    e['StartDir'] = quote(game_path)
    e['icon'] = icon_path
    e['ShortcutPath'] = ''
    e['LaunchOptions'] = quote(game_path) + (' --keep-steam' if keep_steam else '')
    e['IsHidden'] = 0
    e['AllowDesktopConfig'] = 1
    e['AllowOverlay'] = 1
    e['OpenVR'] = 0
    e['Devkit'] = 0
    e['DevkitGameID'] = ''
    e['DevkitOverrideAppID'] = 0
    e['LastPlayTime'] = 0
    e['FlatpakAppID'] = ''
    e['sortas'] = ''
    e['tags'] = collections.OrderedDict()
    return e


def ask(text, default=False, tty=True):
    if not tty:
        print('%s  [no terminal here -> %s]' % (text, 'yes' if default else 'no'))
        return default
    reply = input('%s  [%s] ' % (text, 'Y/n' if default else 'y/N')).strip().lower()
    return default if not reply else reply in ('y', 'yes')


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog='kytyps5-steam-sync', description='Add the PS5 games of a folder to Steam as '
        'KytyPS5-Native shortcuts, with the name and the artwork of the game itself.',
        epilog=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('dir', nargs='?', default=DEFAULT_GAMES_DIR,
                    help='folder with one subfolder per game (default %s)' % DEFAULT_GAMES_DIR)
    ap.add_argument('--runner', default=DEFAULT_RUNNER,
                    help='the kytyps5-run to start through (default %s)' % DEFAULT_RUNNER)
    ap.add_argument('--lang', default=PREFERRED_LANG,
                    help='title language of param.json (default %s)' % PREFERRED_LANG)
    ap.add_argument('--name-suffix', default=GAME_SUFFIX,
                    help='behind the game name, like the ASTRO BOT entry (default "%s")' % GAME_SUFFIX)
    ap.add_argument('--steam-user', default=None, help='userdata id when Steam has several')
    ap.add_argument('--list', action='store_true', help='only show what is there and what differs')
    ap.add_argument('--dry-run', action='store_true', help='change nothing')
    ap.add_argument('--yes', '-y', action='store_true',
                    help='stop and restart a running Steam without asking')
    ap.add_argument('--prune', action='store_true',
                    help='remove the shortcuts (and their artwork) whose game folder is gone '
                    'without asking; without it you are asked for each one')
    ap.add_argument('--keep-steam', action='store_true',
                    help='add --keep-steam: Steam stays up while the game runs')
    ap.add_argument('--no-art', action='store_true', help='leave the artwork alone')
    ap.add_argument('--force-art', action='store_true', help='re-copy the artwork even when current')
    ap.add_argument('--art-only', action='store_true',
                    help='only re-copy artwork for the shortcuts that already exist')
    ap.add_argument('--no-restart', action='store_true', help='leave Steam stopped at the end')
    args = ap.parse_args(argv)

    games_dir = os.path.abspath(os.path.expanduser(args.dir))
    if not os.path.isdir(games_dir):
        raise SystemExit('no such folder: %s' % games_dir)
    runner = args.runner if os.path.isabs(args.runner) else shutil.which(args.runner)
    if not runner or not os.path.exists(runner):
        raise SystemExit('%s not found (install kytyps5-native-git, or pass --runner)' % args.runner)

    user, vdf_path = find_shortcuts_vdf(args.steam_user)
    grid_dir = os.path.join(os.path.dirname(vdf_path), 'grid')
    top, entries = vdf_read(vdf_path)
    state = {}
    for name in (STATE_NAME,) + OLD_STATE_NAMES:
        try:
            with open(os.path.join(games_dir, name), encoding='utf-8') as fh:
                state = json.load(fh)
            break
        except (OSError, ValueError):
            continue

    games, skipped = [], []
    for name in sorted(os.listdir(games_dir)):
        path = os.path.join(games_dir, name)
        if not os.path.isdir(path) or name.startswith('.'):
            continue
        game = Game(path, args.lang)
        if game.looks_installed():
            games.append(game)
        else:
            skipped.append(name)

    kyty = [(idx, e) for idx, e in entries.items()
            if isinstance(e, dict) and is_kyty_entry(e)]

    real_games_dir = os.path.realpath(games_dir)

    def inside(path):
        return bool(path) and any(path == d or path.startswith(d + os.sep)
                                  for d in (games_dir, real_games_dir))

    # A game folder may be a symlink (a game on another drive linked into the
    # games folder): match shortcuts by the folder they really start.
    by_path = collections.OrderedDict()
    for idx, e in kyty:
        if entry_game_path(e):
            by_path.setdefault(os.path.realpath(entry_game_path(e)), []).append((idx, e))
    todo = [g for g in games if not by_path.get(g.path)]
    known = [g for g in games if by_path.get(g.path)]
    matched = {id(e) for g in known for _, e in by_path[g.path]}
    gone = [(idx, e) for idx, e in kyty if id(e) not in matched
            and inside(entry_game_path(e)) and not os.path.isdir(entry_game_path(e))]
    elsewhere = [(idx, e) for idx, e in kyty if id(e) not in matched
                 and not inside(entry_game_path(e))]

    print('games   %s (%d game folder%s)' % (games_dir, len(games), '' if len(games) == 1 else 's'))
    print('steam   %s (userdata %s, %d shortcut%s)'
          % (vdf_path, user, len(entries), '' if len(entries) == 1 else 's'))
    print('art     %s' % grid_dir)
    for g in known:
        entry = by_path[g.path][0][1]
        note = '' if entry.get('appname') == g.appname(args.name_suffix) else \
            '  (Steam calls it %r)' % entry.get('appname')
        print('  = %-32s appid %-11d%s' % (g.appname(args.name_suffix)[:32],
                                           entry_appid(entry), note))
    for g in todo:
        print('  + %-32s %s' % (g.appname(args.name_suffix)[:32], g.dir))
    for name in skipped:
        print('  ! %s: no sce_sys/param.json and no eboot.bin, skipped' % name)
    for idx, e in gone:
        print('  - %-32s its folder is gone: %s%s' % (e.get('appname', '')[:32], entry_game_path(e),
              ''))
    for idx, e in elsewhere:
        print('  . %-32s outside this folder, left alone: %s'
              % (e.get('appname', '')[:32], entry_game_path(e)))
    for path, rows in by_path.items():
        if len(rows) > 1:
            print('  ! %d shortcuts point at the same folder %s' % (len(rows), path))

    if args.list:
        return 0
    if not games and not gone:
        print('\nno game folders here and no shortcut of them to clean up')
        return 0

    tty = sys.stdin.isatty()
    remove = []
    for idx, e in gone:
        if args.prune or ask('Remove the shortcut %r (its game folder is gone)?' % e.get('appname'),
                             default=False, tty=tty):
            remove.append((idx, e))

    # The artwork does not need Steam stopped, so it is done first: it decides
    # which icon file the shortcut has to name (and an icon field only changes
    # with the list, which does need Steam stopped).
    if not args.no_art and known and not args.dry_run:
        print('artwork')
        for g in known:
            idx, e = by_path[g.path][0]
            keep, written, removed, missing = sync_art(
                entry_appid(e), g, grid_dir, state, args.force_art)
            if missing:
                print('  %s: no pic0/icon0 in the game folder, nothing to copy' % g.title)
            else:
                print('  %s: %d copied, %d already there%s'
                      % (g.title, len(written), len(keep),
                         ', %d stale removed' % len(removed) if removed else ''))

    icon_fixes = []
    if not args.no_art:
        for g in known:
            idx, e = by_path[g.path][0]
            want = shortcut_icon(entry_appid(e), grid_dir, g)
            if want and e.get('icon') != want and (args.dry_run or os.path.isfile(want)):
                icon_fixes.append((idx, want))

    need_list = bool(todo or remove or icon_fixes) and not args.art_only
    if args.no_art and not need_list:
        print('\nnothing to do (--no-art, and nothing to add or remove)')
        return 0
    if not need_list and not (known and not args.no_art):
        print('\nnothing to do')
        return 0

    if args.dry_run:
        print('\ndry run, nothing written:')
        for g in todo:
            print('  + %r  %s %s' % (g.appname(args.name_suffix), runner,
                                     quote(g.dir) + (' --keep-steam' if args.keep_steam else '')))
        for idx, e in remove:
            print('  - slot %s %r (appid %d) and its artwork' % (idx, e.get('appname'), entry_appid(e)))
        for idx, want in icon_fixes:
            print('  * slot %s icon -> %s' % (idx, want))
        if not args.no_art:
            for g in known:
                print('  * art of %s into %s for appid %d'
                      % (g.dir, grid_dir, entry_appid(by_path[g.path][0][1])))
        return 0

    restart = None
    if need_list and steam_is_running():
        if not args.yes:
            if not tty:
                raise SystemExit('\nSteam is running: close it and run this again, or use --yes '
                                 'to let this script stop Steam and start it again afterwards.')
            if not ask('Steam is running. Stop it, write the shortcut list and start it again?',
                       default=True, tty=tty):
                raise SystemExit('Steam was not stopped, nothing written')
        restart = steam_stop()
        if not restart:
            raise SystemExit('Steam did not stop within a minute, nothing written')

    try:
        taken = {entry_appid(e) for e in entries.values() if isinstance(e, dict)}
        new_apps = []
        if need_list:
            for idx, want in icon_fixes:
                entries[idx]['icon'] = want
            for g in todo:
                lo = quote(g.dir) + (' --keep-steam' if args.keep_steam else '')
                appid = appid_for(g.appname(args.name_suffix), quote(runner), quote(g.dir),
                                  lo, taken)
                if not args.no_art and not os.path.isdir(grid_dir):
                    os.makedirs(grid_dir, exist_ok=True)
                new_apps.append((g, appid, lo))
            numbered = collections.OrderedDict()
            dropped = {r[0] for r in remove}
            for idx, e in entries.items():
                if idx not in dropped:
                    numbered[str(len(numbered))] = e
            for g, appid, lo in new_apps:
                numbered[str(len(numbered))] = new_entry(
                    appid, g.appname(args.name_suffix), runner, g.dir, args.keep_steam,
                    shortcut_icon(appid, grid_dir, g) or '')
            for g, appid, lo in new_apps:
                if not args.no_art:
                    sync_art(appid, g, grid_dir, state)
            for idx, e in remove:
                forget_art(os.path.realpath(entry_game_path(e)), entry_appid(e), grid_dir, state)
            backup = '%s.bak-%s' % (vdf_path, time.strftime('%Y-%m-%d-%H%M%S'))
            shutil.copy2(vdf_path, backup)
            top['shortcuts'] = numbered
            blob = vdf_write(vdf_path, top)
            for g, appid, lo in new_apps:
                slot = next(k for k, v in numbered.items() if entry_appid(v) == appid)
                print('  + %-32s appid %-11d slot %s  %s %s'
                      % (g.appname(args.name_suffix)[:32], appid, slot, runner, lo))
            print('\nwrote %s: %d shortcut%s (%d added, %d removed, %d icon%s fixed)\n  backup %s'
                  % (vdf_path, len(numbered), '' if len(numbered) == 1 else 's',
                     len(new_apps), len(remove), len(icon_fixes),
                     '' if len(icon_fixes) == 1 else 's', backup))
            if new_apps:
                print('\nRemember: in Steam, turn Steam Input OFF for these shortcuts -- with it')
                print('on, Kyty only sees Steam\'s virtual pad (no motion, haptics, adaptive triggers).')
        try:
            with open(os.path.join(games_dir, STATE_NAME), 'w', encoding='utf-8') as fh:
                json.dump(state, fh, indent=1, sort_keys=True)
            for name in OLD_STATE_NAMES:
                old = os.path.join(games_dir, name)
                if os.path.isfile(old):
                    os.remove(old)
        except OSError as exc:
            print('  ! could not save %s in %s: %s' % (STATE_NAME, games_dir, exc))
    finally:
        if restart:
            if args.no_restart:
                print('Steam is left stopped (start it when you like)')
            else:
                steam_start(restart)
                print('Steam started again')

    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print('\ncancelled')
        sys.exit(130)
